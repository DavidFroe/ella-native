# ELLA CORE LIBRARY - v10.0 (Ella-Pi Bare Metal Edition)
# ================================================================
export ELLA_VERSION="10.0"

# --- NATIVE KONFIGURATION (Raspberry Pi / Linux) ---
export THOUGHT_FILE="$HOME/.ella_thoughts"
export LOG_FILE="$HOME/.ella.log"
export OPENCLAW_JSON_PATH="$HOME/.config/openclaw-kibot/.openclaw/openclaw.json"
export CONFIG_FILE="$OPENCLAW_JSON_PATH"
export OPENCLAW_CONFIG_PATH="$OPENCLAW_JSON_PATH"
export GATEWAY_PORT=18789
export OWLTRAIL_PORT=8081

# Automatische Pfad-Erkennung für native Binaries
export OPENCLAW_BIN=$(which openclaw 2>/dev/null || echo "/usr/local/bin/openclaw")
export OWLTRAIL_DIR="$(dirname "$BASE_DIR")/owltrail"
export OWLTRAIL_BIN="$OWLTRAIL_DIR/owltrail_server.py"
export OWLTRAIL_CLI="$OWLTRAIL_DIR/owltrail"

# --- PERMISSION & TOKEN INITIALIZATION ---
fix_permissions() {
    # 1. Log File
    if [ ! -f "$LOG_FILE" ]; then touch "$LOG_FILE" 2>/dev/null; fi
    
    # 2. Workspace (aus Config extrahieren)
    WS_DIR=$(grep -oP '"workspace":\s*"\K[^"]+' "$OPENCLAW_CONFIG_PATH" 2>/dev/null)
    
    TARGETS=("$LOG_FILE" "$HOME/.config/openclaw-kibot/")
    [ -n "$WS_DIR" ] && TARGETS+=("$WS_DIR")

    for target in "${TARGETS[@]}"; do
        if [ -e "$target" ]; then
            # Ensure my user owns it
            sudo chown -R $USER:$USER "$target" 2>/dev/null || true
            if [ -d "$target" ]; then
                chmod -R 775 "$target" 2>/dev/null || true
            else
                chmod 664 "$target" 2>/dev/null || true
            fi
        fi
    done
}

export_gateway_token() {
    export OPENCLAW_GATEWAY_TOKEN=$(get_token)
}


sync_tokens() {
    # Gateway Config = Quelle der Wahrheit für Tokens
    GW_CONFIG="$HOME/.openclaw/openclaw.json"
    KIBOT_CONFIG="$OPENCLAW_JSON_PATH"
    AUTH_FILE="$HOME/.openclaw/agents/main/agent/auth-profiles.json"

    python3 -c "
import json, os

gw_path = '$GW_CONFIG'
kibot_path = '$KIBOT_CONFIG'
auth_path = '$AUTH_FILE'

# 1. Token von Gateway-Config lesen und in Kibot-Config synchronisieren
gw_token = None
if os.path.exists(gw_path):
    with open(gw_path, 'r') as f: gw = json.load(f)
    gw_token = gw.get('gateway', {}).get('auth', {}).get('token')

    # owltrail Provider in Gateway-Config sicherstellen (mit api: openai!)
    if 'models' not in gw: gw['models'] = {}
    if 'providers' not in gw['models']: gw['models']['providers'] = {}
    prov = gw['models']['providers'].get('custom-localhost-8081', {})
    if not prov or 'api' not in prov:
        gw['models']['providers']['custom-localhost-8081'] = {
            'api': 'openai-completions',
            'baseUrl': 'http://localhost:8081/v1',
            'models': prov.get('models', [{'id': 'auto', 'name': 'auto'}])
        }
        if 'agents' not in gw: gw['agents'] = {}
        if 'defaults' not in gw['agents']: gw['agents']['defaults'] = {}
        gw['agents']['defaults']['model'] = {'primary': 'custom-localhost-8081/auto'}
        if 'models' not in gw['agents']['defaults']:
            gw['agents']['defaults']['models'] = {'custom-localhost-8081/auto': {}}
        with open(gw_path, 'w') as f: json.dump(gw, f, indent=4)

if gw_token and os.path.exists(kibot_path):
    with open(kibot_path, 'r') as f: kb = json.load(f)
    changed = False
    if 'gateway' not in kb: kb['gateway'] = {}
    for key in ['auth', 'remote']:
        if key not in kb['gateway']: kb['gateway'][key] = {}
        if kb['gateway'][key].get('token') != gw_token:
            kb['gateway'][key]['token'] = gw_token
            changed = True
    if changed:
        with open(kibot_path, 'w') as f: json.dump(kb, f, indent=4)

# 2. owltrail Auth-Key sicherstellen
if os.path.exists(auth_path):
    with open(auth_path, 'r') as f: auth = json.load(f)
    if 'custom-localhost-8081:default' not in auth.get('profiles', {}):
        auth['profiles']['custom-localhost-8081:default'] = {
            'type': 'api_key', 'provider': 'custom-localhost-8081', 'key': 'owltrail-local'
        }
        with open(auth_path, 'w') as f: json.dump(auth, f, indent=4)
" 2>/dev/null
}






# --- FARBEN ---
export GREEN='\033[0;32m'
export RED='\033[0;31m'
export BLUE='\033[0;34m'
export YELLOW='\033[0;33m'
export CYAN='\033[0;36m'
export MAGENTA='\033[0;35m'
export GREY='\033[0;90m'
export WHITE='\033[1;37m'
export BOLD='\033[1m'
export NC='\033[0m'

# --- LOGGING SYSTEM ---
# Schreibt immer in das Logfile UND auf die Konsole
log_info() {
    MSG="[INFO] $1"
    echo -e "${GREEN}ℹ️  $1${NC}"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $MSG" >> "$LOG_FILE"
}

log_error() {
    MSG="[ERROR] $1"
    echo -e "${RED}❌ $1${NC}" >&2
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $MSG" >> "$LOG_FILE"
}

# Zeigt Nachrichten nur, wenn --verbose aktiv ist
log_debug() {
    if [ "$ELLA_VERBOSE" == "true" ]; then
        MSG="[DEBUG] $1"
        echo -e "${MAGENTA}🐛 $1${NC}"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] $MSG" >> "$LOG_FILE"
    fi
}

# --- NATIVE HELFER ---
get_token() {
    if [ -z "$CONFIG_FILE" ] || [ ! -f "$CONFIG_FILE" ]; then
        echo "NO_TOKEN"
        return 1
    fi
    TOKEN=$(grep -oP '"token":\s*"\K[^"]+' "$CONFIG_FILE" | head -n 1)
    echo "${TOKEN:-NO_TOKEN}"
}

check_gw_process() {
    pgrep -f "openclaw gateway|openclaw-gateway" > /dev/null
    return $?
}

check_gw_http() {
    TOKEN=$(get_token)
    URL="http://localhost:$GATEWAY_PORT/?token=$TOKEN"
    CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 2 "$URL" 2>/dev/null)
    [ "$CODE" == "200" ]
}

# --- INITIALIZATION ---
# Diese Routinen laufen bei jedem 'source ella-core'
fix_permissions
export_gateway_token
