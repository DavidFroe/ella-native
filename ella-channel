#!/usr/bin/env bash

# ella-channel - OpenClaw Channel Management Wrapper
# Ermöglicht die Steuerung von Telegram, WhatsApp etc. über das ella CLI

BASE_DIR=$(dirname "$(readlink -f "$0")")
source "$BASE_DIR/ella-core"

CMD="$1"
CHANNEL="$2"
PARAM="$3"
EXTRA="$4"

# Pfad zur OpenClaw-Config (klauski-User oder eigene)
resolve_openclaw_config() {
    # Bevorzuge klauski-User-Config wenn vorhanden
    if [ -f "/home/klauski/.openclaw/openclaw.json" ]; then
        echo "/home/klauski/.openclaw/openclaw.json"
    elif [ -f "$HOME/.openclaw/openclaw.json" ]; then
        echo "$HOME/.openclaw/openclaw.json"
    else
        echo "$OPENCLAW_JSON_PATH"
    fi
}

print_usage() {
    echo -e "${BLUE}${BOLD}📱 ELLA CHANNEL MANAGEMENT${NC}"
    echo -e "${GREY}------------------------------------------------------------${NC}"
    echo -e "Steuere externe Messenger für Ella (via OpenClaw Gateway)"
    echo -e ""
    echo -e "  ${GREEN}ella channel list${NC}                    Alle Kanäle & Status"
    echo -e "  ${GREEN}ella channel on <kanal>${NC}              Kanal aktivieren"
    echo -e "  ${GREEN}ella channel off <kanal>${NC}             Kanal deaktivieren"
    echo -e "  ${GREEN}ella channel delete <kanal>${NC}          Kanal & Credentials löschen"
    echo -e "  ${GREEN}ella channel status${NC}                  Verbindungsstatus"
    echo -e ""
    echo -e "${BOLD}📢 Telegram Gruppen:${NC}"
    echo -e "  ${GREEN}ella channel groups${NC}                  Gruppen-Config anzeigen"
    echo -e "  ${GREEN}ella channel groups open${NC}             Alle Gruppen erlauben (kein @mention)"
    echo -e "  ${GREEN}ella channel groups lock${NC}             Nur konfigurierte Gruppen (allowlist)"
    echo -e "  ${GREEN}ella channel groups mention on${NC}       @mention in Gruppen erforderlich"
    echo -e "  ${GREEN}ella channel groups mention off${NC}      @mention nicht erforderlich"
    echo -e "  ${GREEN}ella channel groups add <chat_id>${NC}    Gruppe zur Allowlist hinzufügen"
    echo -e "  ${GREEN}ella channel groups remove <chat_id>${NC} Gruppe aus Allowlist entfernen"
    echo -e ""
    echo -e "${BOLD}🔑 Elevated Permissions (sudo/Root-Befehle vom Bot):${NC}"
    echo -e "  ${GREEN}ella channel elevated${NC}                         Status anzeigen"
    echo -e "  ${GREEN}ella channel elevated on${NC}                      Aktivieren (telegram: alle)"
    echo -e "  ${GREEN}ella channel elevated off${NC}                     Deaktivieren"
    echo -e "  ${GREEN}ella channel elevated add <provider> <id|*>${NC}   Sender freigeben"
    echo -e "  ${GREEN}ella channel elevated remove <provider> <id>${NC}  Sender sperren"
    echo -e ""
    echo -e "${BOLD}🔑 Authentifizierung:${NC}"
    echo -e "  ${CYAN}ella telegram auth <code>${NC}            Telegram Pairing-Code bestätigen"
    echo -e "  ${CYAN}ella whatsapp auth${NC}                   WhatsApp QR-Code Pairing"
    echo -e ""
}

# ---- Telegram Gruppen-Verwaltung ----
cmd_tele_groups() {
    local SUB="$1"
    local ARG1="$2"
    local ARG2="$3"
    local CFG_PATH
    CFG_PATH=$(resolve_openclaw_config)

    if [ ! -f "$CFG_PATH" ]; then
        echo -e "${RED}❌ Config nicht gefunden: $CFG_PATH${NC}"
        exit 1
    fi

    case "$SUB" in
        ""|show|status)
            echo -e "${BLUE}${BOLD}📢 Telegram Gruppen-Config${NC}"
            echo -e "${GREY}$([ "$CFG_PATH" != "$OPENCLAW_JSON_PATH" ] && echo "Config: $CFG_PATH")${NC}"
            python3 - "$CFG_PATH" <<'PYEOF'
import json, sys
path = sys.argv[1]
with open(path) as f: cfg = json.load(f)
tg = cfg.get("channels", {}).get("telegram", {})
policy = tg.get("groupPolicy", "(nicht gesetzt → allowlist fallback!)")
groups = tg.get("groups", {})

policy_color = "\033[32m" if policy == "open" else ("\033[33m" if policy == "allowlist" else "\033[31m")
reset = "\033[0m"

print(f"  groupPolicy : {policy_color}{policy}{reset}")
print(f"  Gruppen-Einträge:")
if not groups:
    print("    (keine)")
else:
    for gid, gcfg in groups.items():
        mention = gcfg.get("requireMention", "(Standard)")
        enabled = gcfg.get("enabled", True)
        status = "" if enabled else " [deaktiviert]"
        print(f"    {gid}{status}  →  requireMention: {mention}")
PYEOF
            echo ""
            echo -e "${GREY}Befehle: ella channel groups open | lock | mention on/off | add <id> | remove <id>${NC}"
            ;;

        open)
            echo -e "${CYAN}🔓 Alle Telegram-Gruppen freischalten (groupPolicy: open)...${NC}"
            python3 - "$CFG_PATH" <<'PYEOF'
import json, sys
path = sys.argv[1]
with open(path) as f: cfg = json.load(f)
tg = cfg.setdefault("channels", {}).setdefault("telegram", {})
tg["groupPolicy"] = "open"
if "groups" not in tg:
    tg["groups"] = {"*": {"requireMention": False}}
elif "*" not in tg["groups"]:
    tg["groups"]["*"] = {"requireMention": False}
with open(path, "w") as f: json.dump(cfg, f, indent=2, ensure_ascii=False)
print("OK")
PYEOF
            echo -e "${GREEN}✅ groupPolicy=open gesetzt — alle Gruppen können schreiben.${NC}"
            _tele_groups_restart_hint
            ;;

        lock|allowlist)
            echo -e "${YELLOW}🔒 Telegram-Gruppen auf allowlist umstellen...${NC}"
            python3 - "$CFG_PATH" <<'PYEOF'
import json, sys
path = sys.argv[1]
with open(path) as f: cfg = json.load(f)
tg = cfg.setdefault("channels", {}).setdefault("telegram", {})
tg["groupPolicy"] = "allowlist"
tg.pop("groups", None)  # Wildcard entfernen — nur explizit gelistete kommen durch
with open(path, "w") as f: json.dump(cfg, f, indent=2, ensure_ascii=False)
print("OK")
PYEOF
            echo -e "${GREEN}✅ groupPolicy=allowlist — nur explizit hinzugefügte Gruppen werden akzeptiert.${NC}"
            echo -e "${GREY}   Tipp: ella channel groups add <chat_id>${NC}"
            _tele_groups_restart_hint
            ;;

        mention)
            local STATE="$ARG1"
            if [ "$STATE" != "on" ] && [ "$STATE" != "off" ]; then
                echo -e "${RED}Verwendung: ella channel groups mention on|off${NC}"
                exit 1
            fi
            local REQUIRE
            [ "$STATE" == "on" ] && REQUIRE="true" || REQUIRE="false"
            echo -e "${CYAN}🔔 @mention in Gruppen: $STATE${NC}"
            python3 - "$CFG_PATH" "$REQUIRE" <<'PYEOF'
import json, sys
path, require = sys.argv[1], sys.argv[2] == "true"
with open(path) as f: cfg = json.load(f)
tg = cfg.setdefault("channels", {}).setdefault("telegram", {})
groups = tg.setdefault("groups", {})
wildcard = groups.setdefault("*", {})
wildcard["requireMention"] = require
# Auch alle anderen Gruppen updaten
for k, v in groups.items():
    if k != "*" and isinstance(v, dict):
        v["requireMention"] = require
with open(path, "w") as f: json.dump(cfg, f, indent=2, ensure_ascii=False)
print("OK")
PYEOF
            if [ "$STATE" == "on" ]; then
                echo -e "${GREEN}✅ @mention erforderlich — Bot antwortet nur wenn er direkt erwähnt wird.${NC}"
            else
                echo -e "${GREEN}✅ @mention deaktiviert — Bot antwortet auf alle Nachrichten in der Gruppe.${NC}"
            fi
            _tele_groups_restart_hint
            ;;

        add)
            local CHAT_ID="$ARG1"
            if [ -z "$CHAT_ID" ]; then
                echo -e "${RED}Verwendung: ella channel groups add <chat_id>${NC}"
                echo -e "${GREY}  Gruppe-IDs beginnen meist mit -100... (Supergroup)${NC}"
                exit 1
            fi
            echo -e "${CYAN}➕ Gruppe $CHAT_ID zur Allowlist hinzufügen...${NC}"
            python3 - "$CFG_PATH" "$CHAT_ID" <<'PYEOF'
import json, sys
path, chat_id = sys.argv[1], sys.argv[2]
with open(path) as f: cfg = json.load(f)
tg = cfg.setdefault("channels", {}).setdefault("telegram", {})
if tg.get("groupPolicy") != "open":
    tg["groupPolicy"] = "allowlist"
groups = tg.setdefault("groups", {})
if chat_id not in groups:
    groups[chat_id] = {"requireMention": False}
    print("ADDED")
else:
    print("EXISTS")
with open(path, "w") as f: json.dump(cfg, f, indent=2, ensure_ascii=False)
PYEOF
            echo -e "${GREEN}✅ Gruppe $CHAT_ID freigegeben.${NC}"
            _tele_groups_restart_hint
            ;;

        remove|del)
            local CHAT_ID="$ARG1"
            if [ -z "$CHAT_ID" ]; then
                echo -e "${RED}Verwendung: ella channel groups remove <chat_id>${NC}"
                exit 1
            fi
            echo -e "${YELLOW}➖ Gruppe $CHAT_ID aus Config entfernen...${NC}"
            python3 - "$CFG_PATH" "$CHAT_ID" <<'PYEOF'
import json, sys
path, chat_id = sys.argv[1], sys.argv[2]
with open(path) as f: cfg = json.load(f)
tg = cfg.get("channels", {}).get("telegram", {})
groups = tg.get("groups", {})
if chat_id in groups:
    del groups[chat_id]
    with open(path, "w") as f: json.dump(cfg, f, indent=2, ensure_ascii=False)
    print("REMOVED")
else:
    print("NOT_FOUND")
PYEOF
            echo -e "${GREEN}✅ Gruppe $CHAT_ID entfernt.${NC}"
            _tele_groups_restart_hint
            ;;

        *)
            echo -e "${RED}Unbekannter groups-Befehl: $SUB${NC}"
            echo -e "  Verfügbar: show | open | lock | mention on/off | add <id> | remove <id>"
            exit 1
            ;;
    esac
}

_tele_groups_restart_hint() {
    local GW_PID
    GW_PID=$(pgrep -f "openclaw" | head -1)
    if [ -n "$GW_PID" ]; then
        echo -e "${GREY}  → Gateway läuft — Neustart empfohlen: ella openclaw restart${NC}"
    fi
}

# ---- Elevated Tool Permission Verwaltung ----
cmd_elevated() {
    local SUB="$1"
    local ARG1="$2"
    local ARG2="$3"
    local CFG_PATH
    CFG_PATH=$(resolve_openclaw_config)

    if [ ! -f "$CFG_PATH" ]; then
        echo -e "${RED}❌ Config nicht gefunden: $CFG_PATH${NC}"
        exit 1
    fi

    case "$SUB" in
        ""|show|status)
            echo -e "${BLUE}${BOLD}🔑 Elevated Tool Permissions${NC}"
            echo -e "${GREY}Config: $CFG_PATH${NC}"
            python3 - "$CFG_PATH" <<'PYEOF'
import json, sys
path = sys.argv[1]
with open(path) as f: cfg = json.load(f)
elevated = cfg.get("tools", {}).get("elevated", {})
enabled = elevated.get("enabled", False)
allow_from = elevated.get("allowFrom", {})

green = "\033[32m"; red = "\033[31m"; yellow = "\033[33m"; reset = "\033[0m"; grey = "\033[90m"

status_color = green if enabled else red
print(f"  enabled     : {status_color}{enabled}{reset}")
print(f"  allowFrom   :")
if not allow_from:
    print(f"    {yellow}(leer — niemand darf elevated nutzen){reset}")
else:
    for provider, senders in allow_from.items():
        if senders == ["*"]:
            print(f"    {provider}: {green}alle (*){reset}")
        else:
            print(f"    {provider}: {', '.join(str(s) for s in senders)}")

exec_cfg = cfg.get("tools", {}).get("exec", {})
if exec_cfg:
    security = exec_cfg.get("security", "-")
    ask = exec_cfg.get("ask", "-")
    print(f"  exec.security: {grey}{security}{reset}  exec.ask: {grey}{ask}{reset}")
PYEOF
            echo ""
            echo -e "${GREY}Befehle: ella channel elevated on | off | add <provider> <id> | remove <provider> <id>${NC}"
            ;;

        on|enable)
            echo -e "${CYAN}🔓 Elevated Tool aktivieren (telegram: alle Sender)...${NC}"
            python3 - "$CFG_PATH" <<'PYEOF'
import json, sys
path = sys.argv[1]
with open(path) as f: cfg = json.load(f)
tools = cfg.setdefault("tools", {})
elevated = tools.setdefault("elevated", {})
elevated["enabled"] = True
allow_from = elevated.setdefault("allowFrom", {})
if "telegram" not in allow_from:
    allow_from["telegram"] = ["*"]
with open(path, "w") as f: json.dump(cfg, f, indent=2, ensure_ascii=False)
print("OK")
PYEOF
            chown klauski:klauski "$CFG_PATH" 2>/dev/null || true
            echo -e "${GREEN}✅ Elevated aktiviert — Bot kann sudo/Root-Befehle ausführen.${NC}"
            _tele_groups_restart_hint
            ;;

        off|disable)
            echo -e "${YELLOW}🔒 Elevated Tool deaktivieren...${NC}"
            python3 - "$CFG_PATH" <<'PYEOF'
import json, sys
path = sys.argv[1]
with open(path) as f: cfg = json.load(f)
tools = cfg.setdefault("tools", {})
elevated = tools.setdefault("elevated", {})
elevated["enabled"] = False
with open(path, "w") as f: json.dump(cfg, f, indent=2, ensure_ascii=False)
print("OK")
PYEOF
            chown klauski:klauski "$CFG_PATH" 2>/dev/null || true
            echo -e "${GREEN}✅ Elevated deaktiviert — sudo-Befehle vom Bot gesperrt.${NC}"
            _tele_groups_restart_hint
            ;;

        add|allow)
            local PROVIDER="$ARG1"
            local SENDER_ID="$ARG2"
            if [ -z "$PROVIDER" ] || [ -z "$SENDER_ID" ]; then
                echo -e "${RED}Verwendung: ella channel elevated add <provider> <id|*>${NC}"
                echo -e "${GREY}  Beispiele: ella channel elevated add telegram *${NC}"
                echo -e "${GREY}             ella channel elevated add telegram 7616071313${NC}"
                exit 1
            fi
            echo -e "${CYAN}➕ $PROVIDER/$SENDER_ID zu elevated allowFrom hinzufügen...${NC}"
            python3 - "$CFG_PATH" "$PROVIDER" "$SENDER_ID" <<'PYEOF'
import json, sys
path, provider, sender = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f: cfg = json.load(f)
tools = cfg.setdefault("tools", {})
elevated = tools.setdefault("elevated", {})
elevated.setdefault("enabled", True)
allow_from = elevated.setdefault("allowFrom", {})
senders = allow_from.setdefault(provider, [])
if sender not in senders:
    senders.append(sender)
    print("ADDED")
else:
    print("EXISTS")
with open(path, "w") as f: json.dump(cfg, f, indent=2, ensure_ascii=False)
PYEOF
            chown klauski:klauski "$CFG_PATH" 2>/dev/null || true
            echo -e "${GREEN}✅ $PROVIDER/$SENDER_ID freigegeben.${NC}"
            _tele_groups_restart_hint
            ;;

        remove|deny|del)
            local PROVIDER="$ARG1"
            local SENDER_ID="$ARG2"
            if [ -z "$PROVIDER" ] || [ -z "$SENDER_ID" ]; then
                echo -e "${RED}Verwendung: ella channel elevated remove <provider> <id>${NC}"
                exit 1
            fi
            echo -e "${YELLOW}➖ $PROVIDER/$SENDER_ID aus elevated allowFrom entfernen...${NC}"
            python3 - "$CFG_PATH" "$PROVIDER" "$SENDER_ID" <<'PYEOF'
import json, sys
path, provider, sender = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f: cfg = json.load(f)
allow_from = cfg.get("tools", {}).get("elevated", {}).get("allowFrom", {})
senders = allow_from.get(provider, [])
if sender in senders:
    senders.remove(sender)
    with open(path, "w") as f: json.dump(cfg, f, indent=2, ensure_ascii=False)
    print("REMOVED")
else:
    print("NOT_FOUND")
PYEOF
            chown klauski:klauski "$CFG_PATH" 2>/dev/null || true
            echo -e "${GREEN}✅ $PROVIDER/$SENDER_ID entfernt.${NC}"
            _tele_groups_restart_hint
            ;;

        *)
            echo -e "${RED}Unbekannter elevated-Befehl: $SUB${NC}"
            echo -e "  Verfügbar: show | on | off | add <provider> <id> | remove <provider> <id>"
            exit 1
            ;;
    esac
}

# ---- Main ----

if [ -z "$CMD" ]; then
    print_usage
    exit 1
fi

case "$CMD" in
    list|ls)
        echo -e "${BLUE}🔎 Aktuelle OpenClaw Kanäle:${NC}"
        $OPENCLAW_BIN channels list
        ;;

    on)
        if [ -z "$CHANNEL" ]; then
            echo -e "${RED}Fehler: Bitte gib einen Kanal an (z.B. whatsapp, telegram).${NC}"
            exit 1
        fi
        echo -e "${YELLOW}Aktiviere Kanal: $CHANNEL...${NC}"
        $OPENCLAW_BIN config set channels.$CHANNEL.enabled true --json
        echo -e "${GREEN}✅ Kanal $CHANNEL aktiviert.${NC}"
        echo -e "${GREY}Neustart ggf. erforderlich: ella openclaw restart${NC}"
        ;;

    off)
        if [ -z "$CHANNEL" ]; then
            echo -e "${RED}Fehler: Bitte gib einen Kanal an.${NC}"
            exit 1
        fi
        echo -e "${YELLOW}Deaktiviere Kanal: $CHANNEL...${NC}"
        $OPENCLAW_BIN config set channels.$CHANNEL.enabled false --json
        echo -e "${GREEN}✅ Kanal $CHANNEL deaktiviert.${NC}"
        ;;

    delete|rm)
        if [ -z "$CHANNEL" ]; then
            echo -e "${RED}Fehler: Bitte gib einen Kanal an.${NC}"
            exit 1
        fi
        echo -e "${RED}⚠️  Achtung: Dies löscht die lokalen Anmeldedaten für $CHANNEL.${NC}"
        read -p "Fortfahren? [j/N] " choice
        if [[ "$choice" =~ ^[jJ]$ ]]; then
            $OPENCLAW_BIN channels remove --channel "$CHANNEL" --delete
            echo -e "${GREEN}✅ Kanal $CHANNEL und zugehörige Daten gelöscht.${NC}"
        fi
        ;;

    auth)
        if [ -z "$CHANNEL" ]; then
            echo -e "${RED}Fehler: Bitte gib einen Kanal an (whatsapp|telegram).${NC}"
            exit 1
        fi

        if [ "$CHANNEL" == "whatsapp" ] || [ "$CHANNEL" == "wa" ]; then
            echo -e "${BLUE}📱 WhatsApp QR-Code Authentifizierung${NC}"
            echo -e "1. Öffne WhatsApp auf deinem Handy."
            echo -e "2. Gehe zu Einstellungen -> Verknüpfte Geräte -> Gerät hinzufügen."
            echo -e "3. Scanne den QR-Code, der gleich hier erscheint."
            echo -e "${GREY}------------------------------------------------------------${NC}"
            $OPENCLAW_BIN config set channels.whatsapp.enabled true --json >/dev/null 2>&1
            $OPENCLAW_BIN channels login --channel whatsapp

        elif [ "$CHANNEL" == "telegram" ] || [ "$CHANNEL" == "tg" ]; then
            if [ -z "$PARAM" ]; then
                echo -e "${BLUE}📱 Telegram Pairing Auth${NC}"
                echo -e "Verwendung: ${GREEN}ella telegram auth <1234ABCD>${NC}"
                echo -e ""
                echo -e "Wenn du den Bot anschreibst und noch nicht freigeschaltet bist,"
                echo -e "sendet er dir einen kurzen Pairing-Code. Gib diesen hier ein."
                exit 1
            fi
            echo -e "${YELLOW}Telegram Pairing Code authorisieren: $PARAM...${NC}"
            $OPENCLAW_BIN config set channels.telegram.enabled true --json >/dev/null 2>&1
            $OPENCLAW_BIN pairing approve telegram "$PARAM"
        else
            echo -e "${YELLOW}Info: Auth-Flow für diesen Kanal möglicherweise nicht voll unterstützt.${NC}"
            $OPENCLAW_BIN channels login --channel "$CHANNEL"
        fi
        ;;

    # --- Telegram Gruppen (ella channel groups ...) ---
    groups|group)
        cmd_tele_groups "$CHANNEL" "$PARAM" "$EXTRA"
        ;;

    # --- Elevated Tool Permissions (ella channel elevated ...) ---
    elevated|elevate)
        cmd_elevated "$CHANNEL" "$PARAM" "$EXTRA"
        ;;

    status)
        echo -e "${BLUE}🩺 Channel Verbindungsstatus:${NC}"
        $OPENCLAW_BIN channels status
        ;;

    *)
        echo -e "${RED}Unbekannter Channel-Befehl: $CMD${NC}"
        print_usage
        exit 1
        ;;
esac
