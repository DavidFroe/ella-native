#!/bin/bash
source /home/ella/apps/ella-native/ella-core

GW_OK=false
if check_gw_http; then GW_OK=true; fi
INT_OK=$(ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1 && echo "true" || echo "false")
OWL_OK=$(pgrep -f "owltrail.py" >/dev/null && echo "true" || echo "false")

echo -e "${BLUE}🧬 --- ELLA-PI QUICK HEALTH (v${ELLA_VERSION}) ---${NC}"
echo -e "🚀 Status:      ${GREEN}NATIV RUNNING${NC}"
echo -e "🛰️ Gateway:     $([ "$GW_OK" = true ] && echo -e "${GREEN}HTTP 200${NC}" || echo -e "${RED}NICHT ERREICHBAR${NC}")"
echo -e "🦉 OwlTrail:    $([ "$OWL_OK" == "true" ] && echo -e "${GREEN}Verbunden${NC}" || echo -e "${RED}OFFLINE${NC}")"
echo -e "🌐 Internet:    $([ "$INT_OK" == "true" ] && echo -e "${GREEN}Verbunden${NC}" || echo -e "${RED}Getrennt${NC}")"

echo -e "${GREY}-----------------------------------------${NC}"
echo -e "${BLUE}📡 CHANNEL HEALTH:${NC}"

# OpenClaw Health stripping ANSI
OC_HEALTH=$(timeout 5 $OPENCLAW_BIN health 2>/dev/null | sed -e 's/\x1b\[[0-9;]*m//g')

if [ -n "$OC_HEALTH" ]; then
    # Parse TG
    TG_LINE=$(echo "$OC_HEALTH" | grep -i "^Telegram:")
    [ -n "$TG_LINE" ] && echo -e "  💬 Telegram:   ${CYAN}$(echo "$TG_LINE" | sed 's/^Telegram: //')${NC}"
    # Parse WA
    WA_LINE=$(echo "$OC_HEALTH" | grep -i "^WhatsApp:")
    [ -n "$WA_LINE" ] && echo -e "  📱 WhatsApp:   ${CYAN}$(echo "$WA_LINE" | sed 's/^WhatsApp: //')${NC}"
    # Parse Web
    WEB_LINE=$(echo "$OC_HEALTH" | grep -i "^Web Channel:")
    [ -n "$WEB_LINE" ] && echo -e "  🌐 Web:        ${CYAN}$(echo "$WEB_LINE" | sed 's/^Web Channel: //')${NC}"
fi

# --- SELF-HEALING ---
if [ "$GW_OK" = false ]; then
    echo -e "\n${YELLOW}🛠️  Self-Healing: Gateway-Restart erforderlich...${NC}"
    ~/ella/ella-gw-start
fi

    if [ -n "$OC_HEALTH" ]; then
        # Telegram
        TG_LINE=$(echo "$OC_HEALTH" | grep -i "^Telegram:")
        if [ -n "$TG_LINE" ]; then
            TG_STATUS=$(echo "$TG_LINE" | sed 's/^Telegram: //')
            if echo "$TG_LINE" | grep -qi "ok"; then
                echo -e "  💬 Telegram:   ${GREEN}✅ $TG_STATUS${NC}"
            else
                echo -e "  💬 Telegram:   ${RED}❌ $TG_STATUS${NC}"
            fi
        fi

        # WhatsApp
        WA_LINE=$(echo "$OC_HEALTH" | grep -i "^WhatsApp:")
        if [ -n "$WA_LINE" ]; then
            WA_STATUS=$(echo "$WA_LINE" | sed 's/^WhatsApp: //')
            if echo "$WA_LINE" | grep -qi "linked"; then
                echo -e "  📱 WhatsApp:   ${GREEN}✅ $WA_STATUS${NC}"
            else
                echo -e "  📱 WhatsApp:   ${RED}❌ $WA_STATUS${NC}"
            fi
        fi

        # Web Channel (Phone Number)
        WEB_LINE=$(echo "$OC_HEALTH" | grep -i "^Web Channel:")
        if [ -n "$WEB_LINE" ]; then
            WEB_INFO=$(echo "$WEB_LINE" | sed 's/^Web Channel: //')
            echo -e "  🌐 Web:        ${CYAN}$WEB_INFO${NC}"
        fi

        echo -e "${GREY}-----------------------------------------${NC}"
        echo -e "${BLUE}🤖 AGENTS & SESSIONS:${NC}"

        # Agents
        AGENT_LINE=$(echo "$OC_HEALTH" | grep -i "^Agents:")
        if [ -n "$AGENT_LINE" ]; then
            AGENT_INFO=$(echo "$AGENT_LINE" | sed 's/^Agents: //')
            echo -e "  🧠 Agent:      ${CYAN}$AGENT_INFO${NC}"
        fi

        # Heartbeat
        HB_LINE=$(echo "$OC_HEALTH" | grep -i "^Heartbeat")
        if [ -n "$HB_LINE" ]; then
            HB_INFO=$(echo "$HB_LINE" | sed 's/^Heartbeat interval: //')
            echo -e "  💓 Heartbeat:  ${YELLOW}$HB_INFO${NC}"
        fi

        # Sessions (count + last activity)
        SESSION_LINE=$(echo "$OC_HEALTH" | grep -i "^Session store")
        if [ -n "$SESSION_LINE" ]; then
            SESSION_COUNT=$(echo "$SESSION_LINE" | grep -oP '\(\K[0-9]+')
            echo -e "  📋 Sessions:   ${CYAN}${SESSION_COUNT:-?} aktiv${NC}"
        fi

        # Last activity (first "- agent:" line)
        LAST_ACTIVE=$(echo "$OC_HEALTH" | grep "^- agent:" | head -1)
        if [ -n "$LAST_ACTIVE" ]; then
            LAST_AGO=$(echo "$LAST_ACTIVE" | grep -oP '\(\K[^)]+')
            echo -e "  ⏱️  Letzte:     ${YELLOW}${LAST_AGO:-?}${NC}"
        fi
    else
        echo -e "  ${YELLOW}(openclaw health nicht verfügbar)${NC}"
    fi
fi

# --- SELF-HEALING LOGIK ---
if [ "$GW_OK" = false ] && [ -n "$CONTAINER_UP" ] && [ "$1" != "--no-repair" ]; then
    echo -e "\n${YELLOW}🛠️  Gateway offline... Starte automatische Reparatur (Self-Healing)...${NC}"
    
    # 1. Container Warm-Start
    echo -ne "  🌀 Container-Reload...  "
    podman restart "$CONTAINER_NAME" >/dev/null 2>&1
    echo -e "${GREEN}OK${NC}"
    
    # 2. Gateway Force-Launch
    echo -e "  🚀 Gateway-Revive...    "
    ~/ella/ella-gw-start || exit 1
    
    # Check again
    if check_gw_http; then
        echo -e "\n${GREEN}✨ System wurde erfolgreich geheilt!${NC}"
        # Restart the script to show new status
        exec $0 --no-repair
    else
        echo -e "\n${RED}❌ Selbstheilung fehlgeschlagen. Bitte nutze 'ella --reset-full'.${NC}"
    fi
fi

if [ -f "$THOUGHT_FILE" ]; then
    echo -e "${GREY}-----------------------------------------${NC}"
    echo -e "💭 ELLA: \"$(cat $THOUGHT_FILE)\""
fi

