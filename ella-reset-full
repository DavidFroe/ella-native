#!/bin/bash
source /home/david/ella/ella-core

echo -e "${RED}${BOLD}🚨 ELLA-PI HARD RESET (v10.0)${NC}"
echo -e "${GREY}------------------------------------------------------------${NC}"

# 1. SHUTDOWN
echo -e "🛑 1. Stopping Processes..."
/home/david/ella/ella --stop >/dev/null 2>&1

# 2. LOG-WIPE
echo -e "🧹 2. Wiping Logs..."
[ -f "$LOG_FILE" ] && mv "$LOG_FILE" "${LOG_FILE}.old"
> "$LOG_FILE"
rm -f "$HOME/.ella_gw.log" "$HOME/.ella_owltrail.log"

# 3. PORT KILL (Safety)
echo -ne "  🔪 Cleaning Ports $GATEWAY_PORT & $OWLTRAIL_PORT... "
sudo fuser -k $GATEWAY_PORT/tcp 2>/dev/null || true
sudo fuser -k $OWLTRAIL_PORT/tcp 2>/dev/null || true
echo -e "${GREEN}BEREIT${NC}"

# 4. TOKEN REFRESH
echo -e "🔑 4. Token Refresh & Sync..."
sync_tokens
export_gateway_token

# 5. START
echo -e "🚀 5. Mastering Startup..."
/home/david/ella/ella --start

echo -e "\n✨ ${GREEN}${BOLD}Ella-Pi wurde vollständig zurückgesetzt (Bare Metal Edition).${NC}"
