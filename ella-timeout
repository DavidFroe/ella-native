#!/bin/bash
BASE_DIR=$(dirname "$(readlink -f "$0")")
source $BASE_DIR/ella-core

VAL="$1"

# --- SHOW: Aktuelles Timeout anzeigen ---
if [ -z "$VAL" ] || [ "$VAL" = "show" ]; then
    echo -e "${BLUE}⏱️  Aktuelles Timeout:${NC}"
    python3 -c "
import json
try:
    with open('$OWLTRAIL_CONF') as f: d = json.load(f)
    print(f'  owltrail Proxy (HTTP)        : {d.get(\"timeout\", 1800)} Sekunden')
except Exception as e:
    print(f'  ⚠ konnte $OWLTRAIL_CONF nicht lesen: {e}')
"
    bot_python3 -c "
import json
try:
    with open('$OPENCLAW_CONFIG_PATH') as f: d = json.load(f)
    abort_ms = d.get('diagnostics', {}).get('stuckSessionAbortMs')
    warn_ms = d.get('diagnostics', {}).get('stuckSessionWarnMs')
    print(f'  OpenClaw Stuck-Session-Abort : {(abort_ms or 360000)//1000} Sekunden' + ('' if abort_ms else ' (Default)'))
    print(f'  OpenClaw Stuck-Session-Warn  : {(warn_ms or 120000)//1000} Sekunden' + ('' if warn_ms else ' (Default)'))
except Exception as e:
    print(f'  ⚠ konnte openclaw.json nicht lesen: {e}')
"
    exit 0
fi

if [[ ! "$VAL" =~ ^[0-9]+$ ]] && [[ ! "$VAL" =~ ^[0-9]+[sSmM]$ ]]; then
    echo -e "${BLUE}⏱️  ella --timeout — LLM Request Timeout steuern${NC}"
    echo -e "${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${GREEN}ella timeout show${NC}      Aktuelles Timeout anzeigen"
    echo -e "  ${GREEN}ella timeout 120s${NC}      120 Sekunden"
    echo -e "  ${GREEN}ella timeout 2m${NC}        2 Minuten"
    echo -e "  ${GREEN}ella timeout 180${NC}       180 Sekunden"
    exit 1
fi

# Parsing
TIMEOUT_SEC=$VAL
if [[ "$VAL" =~ [sS]$ ]]; then
    TIMEOUT_SEC=${VAL%[sS]}
elif [[ "$VAL" =~ [mM]$ ]]; then
    val_num=${VAL%[mM]}
    TIMEOUT_SEC=$((val_num * 60))
fi

echo -e "${BLUE}⚙️ Setze Timeout für LLM Anfragen auf ${TIMEOUT_SEC} Sekunden...${NC}"

python3 -c "
import json
TIMEOUT = int($TIMEOUT_SEC)
p = '$OWLTRAIL_CONF'
with open(p, 'r') as f: d = json.load(f)
d['timeout'] = TIMEOUT
with open(p, 'w') as f: json.dump(d, f, indent=2)
print(f'✅ owltrail.conf aktualisiert (timeout={TIMEOUT}).')
"

# OpenClaw bricht lange Model-Calls selbst ab (diagnostics.stuckSessionAbortMs,
# Default 360s) — unabhängig vom owltrail-HTTP-Timeout oben. Beide synchron halten,
# sonst killt OpenClaw die Anfrage, bevor owltrail je timeout.
bot_python3 -c "
import json
TIMEOUT_MS = int($TIMEOUT_SEC) * 1000
p = '$OPENCLAW_CONFIG_PATH'
with open(p, 'r') as f: d = json.load(f)
diag = d.setdefault('diagnostics', {})
diag['stuckSessionAbortMs'] = TIMEOUT_MS
diag['stuckSessionWarnMs'] = max(60000, TIMEOUT_MS // 3)
with open(p, 'w') as f: json.dump(d, f, indent=4)
print(f'✅ openclaw.json aktualisiert (stuckSessionAbortMs={TIMEOUT_MS}).')
"

echo -e "${YELLOW}🔄 Starte Gateway und owltrail neu...${NC}"
$BASE_DIR/ella --restart
echo -e "${GREEN}✅ Timeout erfolgreich angewendet!${NC}"
