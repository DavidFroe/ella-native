BASE_DIR=$(dirname "$(readlink -f "$0")")
source $BASE_DIR/ella-core

# Port: laufende Instanz aus PID-Datei, Fallback auf owltrail.conf / 8081
_owltrail_port() {
    if [ -f "$OWLTRAIL_PID" ]; then
        local p; p=$(sed -n '2p' "$OWLTRAIL_PID" 2>/dev/null)
        [ -n "$p" ] && echo "$p" && return
    fi
    python3 -c "
import json, os
try:
    print(json.load(open('$OWLTRAIL_CONF')).get('listen_port', 8081))
except:
    print(8081)
" 2>/dev/null || echo 8081
}

OWLTRAIL_PORT=$(_owltrail_port)
OWLTRAIL_URL="http://localhost:${OWLTRAIL_PORT}"
CMD="$1"

# --- Hilfe ---
show_help() {
    echo -e "${BLUE}${BOLD}🤖 ELLA LLM — Direkter LLM-Zugriff${NC}"
    echo -e "${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${GREEN}ella llm \"text\"${NC}          Direkt mit LLM reden"
    echo -e "  ${GREEN}ella llm models${NC}          Verfügbare Modelle anzeigen"
    echo -e "  ${GREEN}ella llm model${NC}           Aktuelles Modell anzeigen"
    echo -e "  ${GREEN}ella llm model <id>${NC}      Modell setzen"
    echo -e "  ${GREEN}ella llm context show${NC}    Kontext-Größe anzeigen"
    echo -e "  ${GREEN}ella llm test${NC}            owltrail Integrationstest"
    echo ""
    echo -e "  ${GREY}Kein OpenClaw Agent — direkt owltrail → QuiteQue → LLM${NC}"
}

case "$CMD" in

    # --- Modelle auflisten ---
    models)
        echo -e "${BLUE}🤖 Verfügbare LLM-Modelle:${NC}"
        echo -e "${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        curl -s "$OWLTRAIL_URL/v1/models" 2>/dev/null | python3 -c "
import json, sys, os
try:
    data = json.load(sys.stdin)
    models = data.get('data', [])
    try:
        cfg = json.load(open('$OWLTRAIL_CONF'))
        active_id = str(cfg.get('model_id', 'auto'))
    except:
        active_id = 'auto'
    B = '\033[1m'; R = '\033[0m'; MAG = '\033[35m'; GREY = '\033[90m'
    print(f'  {\"ID\":>5s}  {\"Name\":<40s}  {\"Ctx\":>6s}  {\"Provider\":<12s}  Status')
    print('  ' + '─'*82)
    for m in models:
        mid  = str(m.get('id', '?'))
        name = m.get('name', m.get('model_id', mid))
        ctx  = m.get('context_window', '?')
        owner = m.get('owned_by', '?')
        status = m.get('check_status') or m.get('status', 'OK')
        if isinstance(ctx, int):
            if ctx >= 1000000: ctx_h = f'{ctx/1000000:.0f}M'
            elif ctx >= 1000:  ctx_h = f'{ctx//1000}K'
            else:              ctx_h = str(ctx)
        else: ctx_h = str(ctx)
        line = f'  {mid:>5s}  {name:<40s}  {ctx_h:>6s}  {owner:<12s}  {status}'
        if mid == active_id:
            print(f'{MAG}{B}► {line.strip()}{R}  ◄ aktiv')
        else:
            print(line)
except Exception as e:
    print(f'Fehler: {e}')
" 2>/dev/null || echo -e "${RED}❌ owltrail nicht erreichbar (Port ${OWLTRAIL_PORT})${NC}"
        ;;

    # --- Aktuelles Modell anzeigen / setzen ---
    model)
        if [ -z "$2" ]; then
            echo -e "${BLUE}🤖 Modell & Routing (owltrail):${NC}"
            python3 -c "
import json, os, urllib.request

GREY='\033[90m'; CYAN='\033[36m'; GREEN='\033[32m'
YELLOW='\033[33m'; RED='\033[31m'; BOLD='\033[1m'; R='\033[0m'; MAG='\033[35m'

def fmt_ctx(ctx):
    if not isinstance(ctx, int) or ctx <= 0: return '?'
    if ctx >= 1000000: return f'{ctx//1000000}M'
    if ctx >= 1000:    return f'{ctx//1000}K'
    return str(ctx)

def status_color(s):
    s = (s or '').upper()
    if any(k in s for k in ('OK','BEREIT','EINGELOGGT')): return GREEN
    if any(k in s for k in ('BUSY','GENERIERT')):         return YELLOW
    return RED

try:
    cfg = json.load(open('$OWLTRAIL_CONF'))
    model_id = str(cfg.get('model_id', 'auto'))
    username = cfg.get('username', 'ella')

    if model_id == 'auto':
        print(f'  Modus:    {BOLD}auto{R} (QuiteQue wählt)')
    else:
        print(f'  Modus:    {BOLD}{model_id}{R} (fest)')
    print(f'  User:     {GREY}{username}{R}')
    print(f'  Proxy:    {GREY}http://localhost:$OWLTRAIL_PORT/v1{R}')

    # Modell-Liste vom laufenden Proxy holen
    try:
        with urllib.request.urlopen('$OWLTRAIL_URL/v1/models', timeout=3) as r:
            all_models = json.loads(r.read()).get('data', [])
    except:
        all_models = []

    if all_models:
        by_id = {str(m.get('id','')): m for m in all_models}
        print()
        if model_id == 'auto':
            # Auto-Modus: zeige was QuiteQue als erstes wählen würde
            BAD = ('ERROR','OFFLINE','FEHLER','RATE_LIMIT','IDLE','TIMEOUT','ZUGRIFF')
            def usable(m):
                s = (m.get('check_status') or m.get('status') or '').upper()
                return not any(k in s for k in BAD)
            available = [m for m in all_models if usable(m)]
            if available:
                top  = available[0]
                mid  = str(top.get('id','?'))
                name = top.get('name', mid)
                ctx  = fmt_ctx(top.get('context_window'))
                st   = top.get('check_status') or top.get('status') or 'OK'
                sc   = status_color(st)
                print(f'  {BOLD}► QuiteQue wählt:{R} {MAG}{BOLD}{name}{R}  {GREY}[{mid}]{R}  Ctx {CYAN}{ctx}{R}  {sc}{st}{R}')
                for fb in available[1:3]:
                    fid  = str(fb.get('id','?'))
                    fn   = fb.get('name', fid)
                    fctx = fmt_ctx(fb.get('context_window'))
                    fst  = fb.get('check_status') or fb.get('status') or 'OK'
                    print(f'    {GREY}· {fn}  [{fid}]  Ctx {fctx}  {fst}{R}')
            else:
                print(f'  {RED}⚠ Keine verfügbaren Modelle!{R}')
        else:
            # Festes Modell: zeige genau dieses Modell
            m = by_id.get(model_id)
            if m:
                name = m.get('name', model_id)
                ctx  = fmt_ctx(m.get('context_window'))
                st   = m.get('check_status') or m.get('status') or 'OK'
                sc   = status_color(st)
                print(f'  {BOLD}► Aktiv:{R} {MAG}{BOLD}{name}{R}  {GREY}[{model_id}]{R}  Ctx {CYAN}{ctx}{R}  {sc}{st}{R}')
            else:
                print(f'  {BOLD}► Aktiv:{R} {MAG}{model_id}{R}  {GREY}(nicht in Modellliste){R}')
    else:
        print(f'  {YELLOW}owltrail nicht erreichbar — starte mit: ella owltrail start{R}')

except Exception as e:
    print(f'  Fehler: {e}')
" 2>/dev/null
        else
            # Modell setzen
            MODEL="$2"
            python3 -c "
import json, sys, os, urllib.request

model_id  = sys.argv[1]
conf_path = '$OWLTRAIL_CONF'
owl_url   = '$OWLTRAIL_URL'

GREEN='\033[32m'; CYAN='\033[36m'; R='\033[0m'

# owltrail.conf aktualisieren
try:
    with open(conf_path) as f: cfg = json.load(f)
except:
    cfg = {}

cfg['model_id'] = model_id
with open(conf_path, 'w') as f:
    json.dump(cfg, f, indent=2)

# Anzeigename + Kontext aus laufendem Proxy holen
model_name = model_id
ctx_window = None
try:
    with urllib.request.urlopen(f'{owl_url}/v1/models', timeout=3) as r:
        for m in json.loads(r.read()).get('data', []):
            if str(m.get('id','')) == model_id:
                model_name = m.get('name', model_id)
                ctx_window = m.get('context_window')
                break
except:
    pass

print(f'{GREEN}✅ Modell gesetzt: {model_id}{R}', end='')
if model_name != model_id:
    print(f'  ({model_name})', end='')
print()

# Kontext in openclaw-Configs anpassen falls bekannt
if isinstance(ctx_window, int) and ctx_window > 0:
    if ctx_window >= 1000000: h = f'{ctx_window//1000000}M'
    elif ctx_window >= 1000:  h = f'{ctx_window//1000}K'
    else:                     h = str(ctx_window)

    openclaw_paths = [
        os.path.expanduser('~/.openclaw/openclaw.json'),
        os.path.expanduser('~/.config/openclaw-kibot/.openclaw/openclaw.json'),
    ]
    updated = 0
    for cp in openclaw_paths:
        if not os.path.exists(cp): continue
        try:
            with open(cp) as f: cd = json.load(f)
            for prov in cd.get('models',{}).get('providers',{}).values():
                for mod in prov.get('models', []):
                    mod['maxTokens']     = ctx_window
                    mod['contextWindow'] = ctx_window
            with open(cp, 'w') as f: json.dump(cd, f, indent=4)
            updated += 1
        except: pass
    if updated:
        print(f'{CYAN}🔧 Kontext angepasst: {h} ({ctx_window:,} Tokens){R}')
" "$MODEL"
        fi
        ;;

    # --- Kontext ---
    context)
        shift
        $BASE_DIR/ella-context "$@"
        ;;

    # --- Test ---
    test)
        $BASE_DIR/ella-owltrail test
        ;;

    # --- Direkte LLM-Anfrage ---
    ""|--help|-h)
        show_help
        ;;

    *)
        QUERY="$*"
        echo -e "${CYAN}🤖 LLM denkt nach...${NC}"
        ESCAPED_QUERY=$(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$QUERY")
        RESPONSE=$(curl -s "$OWLTRAIL_URL/v1/chat/completions" \
            -H "Content-Type: application/json" \
            -H "Authorization: Bearer owltrail-local" \
            -d "{\"model\":\"auto\",\"messages\":[{\"role\":\"user\",\"content\":$ESCAPED_QUERY}]}" \
            2>/dev/null)

        if [ $? -eq 0 ] && [ -n "$RESPONSE" ]; then
            echo "$RESPONSE" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    c = d.get('choices',[{}])[0].get('message',{}).get('content','')
    if c:
        print(f'\n🦉 {c}')
    else:
        print(f'❌ {d.get(\"error\",{}).get(\"message\",\"Keine Antwort\")}')
except Exception as e:
    print(f'❌ Fehler: {e}')
" 2>/dev/null
        else
            echo -e "${RED}❌ owltrail nicht erreichbar (Port ${OWLTRAIL_PORT}).${NC}"
            echo "   Starte mit: ella owltrail start"
        fi
        ;;
esac
