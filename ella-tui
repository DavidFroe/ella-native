#!/bin/bash
BASE_DIR=$(dirname "$(readlink -f "$0")")
source $BASE_DIR/ella-core

echo -e "${CYAN}💬 Starte ELLA TUI (Text Interface)...${NC}"
echo -e "${YELLOW}(Drücke Strg+C oder tippe 'exit' zum Beenden)${NC}"
echo "------------------------------------------------"

# OpenClaw nativ verfügbar?
if command -v openclaw &>/dev/null; then
    openclaw tui "$@"
    exit 0
fi

# Fallback: Container
if is_inside; then
    openclaw tui "$@"
    exit 0
fi

require_container
distrobox enter "$CONTAINER_NAME" -- openclaw tui "$@"
