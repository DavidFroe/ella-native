#!/bin/bash
BASE_DIR=$(dirname "$(readlink -f "$0")")
source $BASE_DIR/ella-core

VAL="$1"
SESSIONS_DIR="$HOME/.config/openclaw-kibot/.openclaw/agents/main/sessions"

if [ -z "$VAL" ] || [ "$VAL" = "show" ]; then
    echo -e "${BLUE}🧠 Aktive Sessions:${NC}"
    $OPENCLAW_BIN sessions
    exit 0
fi

if [ "$VAL" = "reset" ]; then
    echo -e "${RED}🗑️  Lösche alle Sessions...${NC}"
    rm -rf "$SESSIONS_DIR"/*
    echo -e "${GREEN}✅ Sitzungs-Speicher geleert!${NC}"
    $BASE_DIR/ella --restart
    exit 0
fi

if [ -n "$VAL" ]; then
    # Try deleting specific session
    SESSION_FILE="$SESSIONS_DIR/${VAL}.json"
    if [ -f "$SESSION_FILE" ]; then
        echo -e "${RED}🗑️  Lösche Session '${VAL}'...${NC}"
        rm -f "$SESSION_FILE"
        echo -e "${GREEN}✅ Session gelöscht.${NC}"
    else
        echo -e "${YELLOW}⚠️  Keine Session mit der ID '${VAL}' gefunden.${NC}"
        echo -e "${GREY}Hinweis: Führe 'ella sessions show' aus, um alle IDs zu sehen.${NC}"
    fi
    exit 0
fi
