#!/bin/bash
BASE_DIR=$(dirname "$(readlink -f "$0")")
source $BASE_DIR/ella-core
[ -f "$BASE_DIR/ella.conf" ] && source "$BASE_DIR/ella.conf"

VAL="$1"
BOT_HOME=$(eval echo "~${BOT_USER:-$USER}")
SESSIONS_DIR="$BOT_HOME/.openclaw/agents/main/sessions"

if [ -z "$VAL" ] || [ "$VAL" = "show" ]; then
    echo -e "${BLUE}🧠 Aktive Sessions:${NC}"
    $OPENCLAW_BIN sessions
    exit 0
fi

if [ "$VAL" = "reset" ]; then
    echo -e "${RED}🗑️  Lösche alle Sessions...${NC}"
    bot_run "rm -rf '$SESSIONS_DIR'/*"
    echo -e "${GREEN}✅ Sitzungs-Speicher geleert!${NC}"
    $BASE_DIR/ella --restart
    exit 0
fi

# "self" / "mine" — zuletzt aktive Session automatisch ermitteln und NUR
# diese löschen (kein Neustart, keine anderen Chats betroffen). Gedacht
# dafür, dass der Bot sich selbst auf Zuruf ("vergiss diesen Chat") die
# eigene Erinnerung für genau diese Unterhaltung löscht.
#
# WICHTIG: Wenn der Bot das auf sich SELBST anwendet, tut er das immer
# MITTEN in der laufenden Antwort auf genau die Nachricht, die ihn dazu
# aufgefordert hat -- die Session-Datei ist also in dem Moment noch durch
# den laufenden embedded-Prompt gesperrt. Ein sofortiges Umbenennen reisst
# OpenClaw die Datei unter dem laufenden Versuch weg
# (EmbeddedAttemptSessionTakeoverError) und die Antwort geht komplett
# verloren, ohne dass der Nutzer ueberhaupt eine Fehlermeldung sieht.
# Deshalb hier verzoegert im Hintergrund ausfuehren, NACHDEM die laufende
# Antwort fertig raus ist und die Sperre wieder frei ist.
SELF_MODE=false
if [ "$VAL" = "self" ] || [ "$VAL" = "mine" ]; then
    SELF_MODE=true
    VAL=$(bot_run "$OPENCLAW_BIN sessions --json --limit 3" 2>/dev/null | \
        python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    for s in d.get('sessions', []):
        if s.get('key') != 'agent:main:watchdog-ping':
            print(s['key'])
            break
except Exception:
    pass
" 2>/dev/null)
    if [ -z "$VAL" ]; then
        echo -e "${RED}❌ Konnte aktuelle Session nicht automatisch ermitteln.${NC}"
        exit 1
    fi
fi

if [ -n "$VAL" ] && [ "$SELF_MODE" = true ]; then
    echo -e "${GREEN}✅ Ok, ich vergesse diesen Chat — wird gleich nach dieser Antwort wirksam.${NC}"
    ( bot_run "sleep 45; python3 '$BASE_DIR/ella-session-clear.py' '$SESSIONS_DIR' '$VAL' > /dev/null 2>&1; $OPENCLAW_BIN sessions cleanup --fix-missing --enforce > /dev/null 2>&1" ) >> "$ELLA_WATCHDOG_LOG" 2>&1 &
    disown
    exit 0
fi

if [ -n "$VAL" ]; then
    KEY=$(bot_python3 "$BASE_DIR/ella-session-clear.py" "$SESSIONS_DIR" "$VAL" 2>&1)
    if [ $? -ne 0 ]; then
        echo -e "${YELLOW}⚠️  Keine Session gefunden für '${VAL}'.${NC}"
        echo -e "${GREY}Hinweis: Führe 'ella sessions show' aus, um alle Sessions zu sehen.${NC}"
        exit 1
    fi
    echo -e "${RED}🗑️  Lösche Erinnerung für Session '${KEY}'...${NC}"
    bot_run "$OPENCLAW_BIN sessions cleanup --fix-missing --enforce" > /dev/null 2>&1
    echo -e "${GREEN}✅ Session gelöscht — nächste Nachricht in diesem Chat startet frisch.${NC}"
    exit 0
fi
