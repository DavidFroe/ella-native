#!/bin/bash
# ================================================================
# ELLA REPAIR UTILITY - v10.0
# ================================================================
BASE_DIR=$(dirname "$(readlink -f "$0")")
source $BASE_DIR/ella-core

echo -e "${BLUE}${BOLD}🛠️  ELLA-PI REPAIR WIZARD${NC}"
echo -e "${GREY}-----------------------------------------${NC}"

show_menu() {
    echo -e "Wähle eine Reparatur-Option:"
    echo -e "  ${CYAN}[1]${NC} Berechtigungen fixen (chown/chmod)"
    echo -e "  ${CYAN}[2]${NC} WhatsApp Sessions zurücksetzen (Fix Bad MAC)"
    echo -e "  ${CYAN}[3]${NC} Emergency Gateway Cleanup (Locks & PIDs)"
    echo -e "  ${CYAN}[4]${NC} OpenClaw Doctor --fix ausführen"
    echo -e "  ${CYAN}[5]${NC} owltrail Provider (custom-localhost) reparieren"
    echo -e "  ${CYAN}[6]${NC} Konfiguration wiederherstellen (Reset Configs)"
    echo -e "  ${CYAN}[7]${NC} Full System Reset (ella --reset-full)"
    echo -e "  ${CYAN}[8]${NC} OpenClaw Diagnose (ella openclaw diagnose)"
    echo -e "  ${CYAN}[9]${NC} OpenClaw Hard-Fix (ella openclaw fix hard)"
    echo -e "  ${CYAN}[u]${NC} OpenClaw Update (npm)"
    echo -e "  ${CYAN}[q]${NC} Abbrechen"
    echo -ne "\nOption: "
}

fix_perms() {
    echo -e "${YELLOW}🔧 Fixe Berechtigungen...${NC}"
    fix_permissions # Aus ella-core
    sudo chown -R $USER:$USER $HOME/apps/ 2>/dev/null
    sudo chown -R $USER:$USER $HOME/.config/openclaw-kibot/ 2>/dev/null
    sudo chown -R $USER:$USER $HOME/.openclaw/ 2>/dev/null
    echo -e "${GREEN}✅ Berechtigungen aktualisiert.${NC}"
}

reset_wa() {
    echo -e "${RED}⚠️  WARNUNG: Alle WhatsApp-Sitzungen werden gelöscht!${NC}"
    echo -e "Du musst danach den QR-Code neu scannen (ella --whatsapp auth)."
    echo -ne "Sicher? [y/N]: "
    read -r confirm
    if [[ "$confirm" =~ ^[yY]$ ]]; then
        echo -e "${YELLOW}🧹 Lösche Sessions...${NC}"
        rm -rf $HOME/.config/openclaw-kibot/.openclaw/agents/main/sessions/*
        echo -e "${GREEN}✅ WhatsApp Sessions gelöscht. Bitte ella neu starten.${NC}"
    else
        echo -e "${GREY}Abgebrochen.${NC}"
    fi
}

gateway_cleanup() {
    echo -e "${YELLOW}🛑 Stopping all Gateway processes...${NC}"
    $OPENCLAW_BIN gateway stop >/dev/null 2>&1 || true
    sudo pkill -f "openclaw gateway" 2>/dev/null || true
    sudo pkill -f "openclaw-gateway" 2>/dev/null || true
    
    echo -e "${YELLOW}🧹 Removing lock files and PID files...${NC}"
    rm -f /tmp/openclaw-gateway.pid 2>/dev/null
    rm -rf /tmp/openclaw/ 2>/dev/null
    
    # Check for port blockage
    if sudo fuser $GATEWAY_PORT/tcp >/dev/null 2>&1; then
        echo -e "${RED}⚠️  Port $GATEWAY_PORT ist noch blockiert!${NC}"
        sudo fuser -k $GATEWAY_PORT/tcp 2>/dev/null
    fi

    echo -e "${YELLOW}🚀 Restarting Gateway...${NC}"
    $BASE_DIR/ella gateway start
    echo -e "${GREEN}✅ Cleanup abgeschlossen.${NC}"
}

run_doctor() {
    echo -e "${BLUE}🩺 Starte OpenClaw Doctor...${NC}"
    $OPENCLAW_BIN doctor --fix
    echo -e "${GREEN}✅ Doctor fertig.${NC}"
}

fix_owltrail_provider() {
    echo -e "${YELLOW}🔧 Repariere owltrail Provider Integration...${NC}"
    sync_tokens # Aus ella-core sorgt bereits für den Provider
    echo -e "${GREEN}✅ owltrail Provider ('custom-localhost-8081') wurde sichergestellt.${NC}"
}

restore_config() {
    echo -e "${YELLOW}⚙️  Konfiguration wird wiederhergestellt...${NC}"
    
    # 1. Ensure directories exist
    mkdir -p "$HOME/.openclaw"
    mkdir -p "$(dirname "$OPENCLAW_JSON_PATH")"

    # 2. Check if main config is missing/empty
    if [ ! -s "$OPENCLAW_JSON_PATH" ]; then
        echo -e "${BLUE}  Creating default Kibot config...${NC}"
        echo '{"gateway":{"auth":{"token":"ella-pi-secret"},"port":18789}}' > "$OPENCLAW_JSON_PATH"
    fi

    # 3. Check if OpenClaw default config is missing
    GW_DEFAULT="$HOME/.openclaw/openclaw.json"
    if [ ! -s "$GW_DEFAULT" ]; then
        echo -e "${BLUE}  Creating default Gateway config...${NC}"
        echo '{"gateway":{"auth":{"token":"ella-pi-secret"},"port":18789}}' > "$GW_DEFAULT"
    fi

    # 4. Sync tokens and models
    echo -e "${BLUE}  Synchronizing settings...${NC}"
    sync_tokens # Aus ella-core
    
    echo -e "${GREEN}✅ Konfiguration wiederhergestellt.${NC}"
}

while true; do
    show_menu
    read -r opt
    case $opt in
        1) fix_perms ;;
        2) reset_wa ;;
        3) gateway_cleanup ;;
        4) run_doctor ;;
        5) fix_owltrail_provider ;;
        6) restore_config ;;
        7) $BASE_DIR/ella --reset-full; exit 0 ;;
        8) bash $BASE_DIR/ella-openclaw diagnose ;;
        9) bash $BASE_DIR/ella-openclaw fix hard ;;
        u|U) bash $BASE_DIR/ella-openclaw update ;;
        q|Q) exit 0 ;;
        *) echo -e "${RED}Ungültige Option.${NC}" ;;
    esac
    echo -e "${GREY}-----------------------------------------${NC}"
done
