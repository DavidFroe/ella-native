#!/usr/bin/env bash
BASE_DIR=$(dirname "$(readlink -f "$0")")
source $BASE_DIR/ella-core

COMMAND="$1"

# 1. SMART DIRECT ASK (Nativ)
if [[ "$COMMAND" != --* ]] && [ -n "$COMMAND" ]; then
    case "$COMMAND" in
        status|start|stop|restart|help|backup|restore|migrate|logs|tail|tui|diagnose|chat|debug|top|task|watchdog|web|alcohol|soul|skills|sessions|tele|models|context|timeout|test-llm|version|channel|whatsapp|wa|telegram|tg|owltrail|openclaw|gateway|repair|quiteque|qq|deepthink|update)
            COMMAND="--$COMMAND"
            ;;
        *)
            # Nur als LLM-Prompt wenn das Argument Leerzeichen/Interpunktion enthält (Gänsefüßchen)
            # oder wenn mehrere separate Argumente gegeben wurden
            if [[ "$COMMAND" =~ [[:space:]] ]] || [ $# -gt 1 ]; then
                # Enthält Leerzeichen oder mehrere Argumente → echte Frage
                $BASE_DIR/ella-ask "$*"
                exit 0
            else
                # Ein Wort ohne Leerzeichen, kein bekannter Befehl → Error
                echo -e "${RED}❌ Unbekannter Befehl: $1${NC}"
                echo -e "   Meintest du einen dieser Befehle? ${CYAN}ella --help${NC}"
                echo -e "   Für eine Frage: ${GREEN}ella \"deine Frage hier\"${NC}"
                exit 1
            fi
            ;;
    esac
fi

shift
PARAM="$*"

case "$COMMAND" in
    # --- SYSTEM INFO ---
    --version|--v)
        echo -e "${CYAN}ELLA v$ELLA_VERSION${NC} (Native Edition)"
        exit 0
        ;;

    # --- DIAGNOSTICS & STATUS ---
    --health)   $BASE_DIR/ella-health ;;
    --status)   $BASE_DIR/ella-status ;;
    --test-llm) $BASE_DIR/ella-test-llm ;;
    
    --logs|--tail)
        echo -e "${BLUE}📋 ELLA LOGS (Tail)${NC}"
        tail -f "$LOG_FILE"
        ;;

    --logs-clear)
        echo -e "${BLUE}🧹 Clearing Logs...${NC}"
        [ -f "$LOG_FILE" ] && mv "$LOG_FILE" "${LOG_FILE}.old"
        > "$LOG_FILE"
        echo -e "${GREEN}Host logs cleared. Archiv created.${NC}"
        ;;

    --usage)    top -b -n 1 | grep -E "openclaw|python3|ella" ;;
    --top)      htop ;;

    --tui|--chat)
        bash $BASE_DIR/ella-tui $PARAM
        ;;

    # --- SYSTEM CONTROL (Native) ---
    --start)
        echo -e "${BLUE}🚀 ELLA STARTUP SEQUENCE${NC}"
        echo -e "${GREY}-----------------------------------------${NC}"
        sync_tokens
        export_gateway_token
        
        # Kill zombies on Gateway port only (not owltrail!)
        sudo fuser -k $GATEWAY_PORT/tcp > /dev/null 2>&1 || true
        
        # Start Gateway (kein systemd hier — Hintergrundprozess via nohup als BOT_USER)
        echo -ne "  🚀 Launching Gateway...  "
        GW_LOG="$BOT_USER_HOME/.openclaw-gateway.log"
        GW_PID="$BOT_USER_HOME/.openclaw-gateway.pid"
        sudo -u "$BOT_USER" bash -c "
            source /home/$BOT_USER/.nvm/nvm.sh 2>/dev/null
            export XDG_RUNTIME_DIR=/run/user/\$(id -u)
            nohup openclaw gateway > '$GW_LOG' 2>&1 &
            echo \$! > '$GW_PID'
        " 2>/dev/null
        GW_OK=false
        for i in $(seq 1 8); do
            if check_gw_http; then
                GW_OK=true
                break
            fi
            sleep 1
            echo -ne "."
        done
        if $GW_OK; then
            echo -e " ${GREEN}OK${NC}"
        elif check_gw_process; then
            echo -e " ${YELLOW}STARTING${NC} (Prozess läuft, HTTP noch nicht ready)"
        else
            echo -e " ${RED}FAILED${NC}"
            bot_run "tail -n 15 '$GW_LOG'" 2>/dev/null | sed "s/^/${GREY}/"
        fi
        
        # Start owltrail (integrierte Bibliothek)
        echo -ne "  🦉 Launching owltrail... "
        if [ -f "$OWLTRAIL_RUNNER" ]; then
            bash "$BASE_DIR/ella-owltrail" start 2>/dev/null | tail -1
        else
            echo -e "${YELLOW}SKIP (owltrail.py nicht gefunden)${NC}"
        fi

        echo -e "${GREY}-----------------------------------------${NC}"
        echo -e "${GREEN}${BOLD}🚀 Ella ist online.${NC}"
        ;;

    --stop)
        echo -e "${YELLOW}🛑 Stopping Ella Components...${NC}"
        bot_run "pkill -x openclaw" 2>/dev/null || true
        bash "$BASE_DIR/ella-owltrail" stop 2>/dev/null || true
        echo -e "${GREEN}Cleaned up all processes.${NC}"
        ;;

    --restart)
        $0 --stop
        sleep 1
        $0 --start
        ;;

    # --- GATEWAY (Shortcut → openclaw) ---
    --gateway)
        bash $BASE_DIR/ella-openclaw $PARAM
        ;;

    --reset-full)
        echo -e "${RED}${BOLD}🚨 HARD RESET${NC}"
        $0 --stop
        $0 --logs-clear
        $0 --start
        ;;

    --repair)
        $BASE_DIR/ella-repair
        ;;

    --update)
        echo -e "${BLUE}${BOLD}🔄 ELLA UPDATE${NC}"
        echo -e "${GREY}-----------------------------------------${NC}"
        cd "$BASE_DIR" || exit 1

        if [ -n "$(git status --porcelain --untracked-files=no 2>/dev/null)" ]; then
            echo -e "${RED}❌ Lokale Änderungen an versionierten Dateien gefunden — Update abgebrochen.${NC}"
            echo -e "${GREY}   git -C $BASE_DIR status${NC}"
            echo -e "${GREY}   Erst committen/verwerfen, dann 'ella update' erneut versuchen.${NC}"
            exit 1
        fi

        echo -ne "  📥 Hole neuesten Stand von GitHub...  "
        if git pull --ff-only origin main 2>&1 | grep -q "Already up to date"; then
            echo -e "${GREEN}bereits aktuell.${NC}"
        else
            echo -e "${GREEN}OK${NC}"
        fi

        chmod +x ella ella-* *.sh 2>/dev/null || true

        echo -e "\n  ${CYAN}Starte laufende Dienste neu, damit Änderungen wirken...${NC}"
        if check_gw_process; then
            echo -ne "    🛰️  Gateway...  "
            bash "$BASE_DIR/ella-openclaw" restart > /dev/null 2>&1 && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}prüfen${NC}"
        fi
        if bot_run "[ -f '$OWLTRAIL_PID' ] && kill -0 \$(head -1 '$OWLTRAIL_PID') 2>/dev/null"; then
            echo -ne "    🦉 owltrail...  "
            bash "$BASE_DIR/ella-owltrail" restart > /dev/null 2>&1 && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}prüfen${NC}"
        fi
        if bot_run "pgrep -f 'ella-web.py' > /dev/null 2>&1"; then
            echo -ne "    🌐 Webseite...  "
            bash "$BASE_DIR/ella-web" restart > /dev/null 2>&1 && echo -e "${GREEN}OK${NC}" || echo -e "${YELLOW}prüfen${NC}"
        fi

        echo -e "${GREY}-----------------------------------------${NC}"
        echo -e "${GREEN}${BOLD}✅ Update abgeschlossen.${NC}"
        ;;

    --deepthink)
        $BASE_DIR/ella-deepthink $PARAM
        ;;

    # --- GLOBETROTTER BACKUP & RESTORE ---
    --backup)
        BKP_FILE="$HOME/ella_backup_$(date +%Y%m%d_%H%M%S).tar.gz"
        echo -e "${BLUE}📦 Erstelle Globetrotter Backup...${NC}"
        cd "$HOME" || exit
        tar -czf "$BKP_FILE" .config/openclaw-kibot/ .ella_thoughts 2>/dev/null
        echo -e "${GREEN}✅ Backup gespeichert: $BKP_FILE${NC}"
        ;;

    --restore)
        if [ -z "$PARAM" ]; then
            echo -e "${RED}Fehler: Bitte gib eine Backup-Datei an.${NC}"
            exit 1
        fi
        echo -e "${YELLOW}⚠️  RESTORE: Bestehende Konfiguration wird überschrieben!${NC}"
        echo -n "Fortfahren? [j/N] "
        read -r choice
        if [[ "$choice" =~ ^[jJ]$ ]]; then
            tar -xzf "$PARAM" -C "$HOME"
            echo -e "${GREEN}✅ Restore abgeschlossen. Bitte 'ella --restart' ausführen.${NC}"
        fi
        ;;

    --migrate)
        $BASE_DIR/ella-migrate
        ;;

    # --- OPENCLAW ADMIN ---
    --openclaw)
        bash $BASE_DIR/ella-openclaw $PARAM
        ;;

    # --- Shortcuts (Rückwärtskompatibilität) ---
    --sessions) bash $BASE_DIR/ella-openclaw sessions $PARAM ;;
    --context)  bash $BASE_DIR/ella-owltrail context $PARAM ;;
    --timeout)  bash $BASE_DIR/ella-owltrail timeout $PARAM ;;
    --models)   bash $BASE_DIR/ella-owltrail models ;;
    --tele)     bash $BASE_DIR/ella-tele "$PARAM" ;;
    --thought)  [ -n "$PARAM" ] && echo "$PARAM" > "$THOUGHT_FILE" || cat "$THOUGHT_FILE" ;;
    
    # --- OWLTRAIL PROXY ---
    --owltrail)
        bash $BASE_DIR/ella-owltrail $PARAM
        ;;

    # --- AUFGABENSPEICHER & WATCHDOG ---
    --task)
        bash "$BASE_DIR/ella-task" "$@"
        ;;
    --watchdog)
        bash "$BASE_DIR/ella-watchdog" "$@"
        ;;

    # --- STATUS-/SKILLS-WEBSEITE ---
    --web)
        bash "$BASE_DIR/ella-web" "$@"
        ;;

    # --- ALKOHOLSTAND (Klauski) ---
    --alcohol)
        bash "$BASE_DIR/ella-alcohol" "$@"
        ;;

    # --- BOT-IDENTITÄT / PERSONA ---
    --soul)
        bash "$BASE_DIR/ella-soul" "$@"
        ;;

    # --- BOT-SKILLS VERWALTEN ---
    --skills)
        bash "$BASE_DIR/ella-skills" "$@"
        ;;

    # --- QUITEQUE MIDDLEWARE ---
    --quiteque|--qq)
        QQ_CMD=$(echo "$PARAM" | awk '{print $1}')
        QQ_ARGS=$(echo "$PARAM" | awk '{$1=""; print $0}' | sed 's/^ //')
        if [ -x "$HOME/apps/QuiteQue/qq" ]; then
            $HOME/apps/QuiteQue/qq ${QQ_CMD:-help} $QQ_ARGS
        else
            echo -e "${RED}❌ QuiteQue nicht installiert. Installiere mit: cd ~/apps/QuiteQue && ./install.sh${NC}"
        fi
        ;;

    # --- owltrail (Alias ella llm → ella owltrail, veraltet) ---
    --llm)
        echo -e "${YELLOW}⚠️  'ella llm' ist veraltet → bitte 'ella owltrail' verwenden${NC}"
        bash $BASE_DIR/ella-owltrail $PARAM
        ;;

    # --- EXTERNAL CHANNELS (OpenClaw) ---
    --channel)
        bash $BASE_DIR/ella-channel $PARAM
        ;;
    --whatsapp|--wa)
        cmd_part=$(echo "$PARAM" | awk '{print $1}')
        rest_part=$(echo "$PARAM" | cut -d' ' -f2-)
        if [ -n "$cmd_part" ] && [[ "$cmd_part" != auth* ]] && [[ "$cmd_part" != on* ]] && [[ "$cmd_part" != off* ]] && [[ "$cmd_part" != status* ]]; then
            # Chat-Nachricht: ella whatsapp "text" → über OpenClaw an WhatsApp
            echo -e "${CYAN}📱 Sende über WhatsApp...${NC}"
            sync_tokens
            $OPENCLAW_BIN agent --agent main --channel whatsapp --deliver --message "$PARAM"
        else
            bash $BASE_DIR/ella-channel "$cmd_part" whatsapp "$rest_part"
        fi
        ;;
    --telegram|--tg)
        cmd_part=$(echo "$PARAM" | awk '{print $1}')
        rest_part=$(echo "$PARAM" | cut -d' ' -f2-)
        if [ -n "$cmd_part" ] && [[ "$cmd_part" != auth* ]] && [[ "$cmd_part" != on* ]] && [[ "$cmd_part" != off* ]] && [[ "$cmd_part" != status* ]] && [[ "$cmd_part" != group* ]] && [[ "$cmd_part" != elevated* ]]; then
            # Chat-Nachricht: ella telegram "text" → über OpenClaw an Telegram
            echo -e "${CYAN}📱 Sende über Telegram...${NC}"
            sync_tokens
            $OPENCLAW_BIN agent --agent main --channel telegram --deliver --message "$PARAM"
        else
            bash $BASE_DIR/ella-channel "$cmd_part" telegram "$rest_part"
        fi
        ;;
    
    --help|*)   $BASE_DIR/ella-help ;;
esac
