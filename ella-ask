BASE_DIR=$(dirname "$(readlink -f "$0")")
source $BASE_DIR/ella-core

QUERY="$*"
if [ -z "$QUERY" ]; then
    echo "Usage: ella <fragetext>"
    exit 1
fi

# 1. NATIVE HEALTH CHECK
if ! check_gw_http; then
    echo -e "${YELLOW}⚠️  Gateway offline. Starte Ella-Pi...${NC}"
    $BASE_DIR/ella-gw-start || exit 1
fi

echo -e "${CYAN}🧠 ELLA denkt nach...${NC}"

# 2. Tokens synchronisieren
sync_tokens

# 3. OPENCLAW AGENT via Gateway (--json für parsbare Ausgabe)
export OPENCLAW_GATEWAY_TOKEN="$OPENCLAW_GATEWAY_TOKEN"
export OPENCLAW_CONFIG_PATH="$OPENCLAW_CONFIG_PATH"

RESPONSE=$($OPENCLAW_BIN agent --agent main --message "$QUERY" --json 2>/dev/null)
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ] || [ -z "$RESPONSE" ]; then
    echo -e "${YELLOW}⚠️  Agent fehlgeschlagen. Fallback auf LLM...${NC}"
    $BASE_DIR/ella-llm "$QUERY"
    exit $?
fi

# 4. JSON Response parsen — payloads[].text anzeigen
echo "$RESPONSE" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    payloads = d.get('result', {}).get('payloads', [])
    if payloads:
        for p in payloads:
            text = p.get('text', p.get('body', ''))
            if text:
                print(f'\n🦉 {text}')
    else:
        status = d.get('status', '?')
        summary = d.get('summary', '')
        print(f'\n⚠️  Agent: {summary} (Status: {status})')
except Exception as e:
    print(f'❌ Parse-Fehler: {e}')
"
