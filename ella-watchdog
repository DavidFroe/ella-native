#!/usr/bin/env bash
# ================================================================
# ELLA WATCHDOG — überwacht, ob der Bot bei einer Aufgabe hängt
#
# Liest den Master-Task aus ella-task. Ist eine Aufgabe "in_progress"
# aber seit ELLA_WATCHDOG_STALE_MIN Minuten kein Heartbeat mehr
# eingegangen, wird per kurzem Lebenszeichen-Ping (wie ella-ask)
# gegengeprüft. Antwortet der Bot dabei trotzdem -> nur Hinweis,
# kein Neustart (falsch-positiv vermeiden). Antwortet er nicht ->
#   1) Gateway wird neu gestartet
#   2) Task wird als "recovered" markiert (kein Restart-Loop)
#   3) Best-effort Hinweis in den ursprünglichen Telegram-Chat
# ================================================================
BASE_DIR=$(dirname "$(readlink -f "$0")")
source "$BASE_DIR/ella-core"

STALE_MIN="${ELLA_WATCHDOG_STALE_MIN:-15}"
RECOVERY_STALE_MIN="${ELLA_WATCHDOG_RECOVERY_STALE_MIN:-10}"
SESSIONS_DIR="$BOT_USER_HOME/.openclaw/agents/main/sessions"
WD_CONFIG_FILE="$BOT_USER_HOME/.ella_watchdog_config.json"
SUB="${1:-check}"
shift 2>/dev/null

_log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$ELLA_WATCHDOG_LOG"
}

# --- Watchdog-eigene Einstellungen (on/off, Intervall, Definitiv-Modus) ---
# Eigene kleine Config statt der fixen 5-Min-systemd-Timer-Tickrate, damit
# "ella watchdog interval/definitive" sofort wirkt, ohne den Timer neu
# installieren zu muessen. Der Timer selbst tickt fein (1 Min., siehe
# "install") -- "check" entscheidet pro Aufruf selbst, ob das konfigurierte
# Intervall schon abgelaufen ist.
_wd_field() {
    bot_python3 -c "
import json
try:
    d = json.load(open('$WD_CONFIG_FILE'))
except Exception:
    d = {}
print(d.get('$1', '$2'))
" 2>/dev/null
}

_wd_set_field() {
    bot_python3 -c "
import json
path = '$WD_CONFIG_FILE'
try:
    d = json.load(open(path))
except Exception:
    d = {}
d['$1'] = $2
with open(path, 'w') as f:
    json.dump(d, f, indent=2)
"
}

# Schickt eine Nachricht in die ursprüngliche Telegram-Session.
# session_key Format: agent:main:telegram:group:-5532952400 / agent:main:telegram:direct:123456
# $1/$2 werden als echte argv-Werte durchgereicht (nie in den Skripttext
# interpoliert) — Sonderzeichen im Aufgabentext können so nichts ausbrechen.
_notify_session() {
    local session="$1" msg="$2" chat_id
    case "$session" in *telegram*) ;; *) return 0 ;; esac
    chat_id=$(echo "$session" | awk -F: '{print $NF}')
    [ -z "$chat_id" ] && return 0
    if [ "$BOT_USER" = "$(whoami)" ]; then
        bash -lc 'source "$HOME/.nvm/nvm.sh" 2>/dev/null; openclaw message send --channel telegram --target "$1" --message "$2"' _ "$chat_id" "$msg" >/dev/null 2>&1
    else
        sudo -u "$BOT_USER" bash -lc 'source "$HOME/.nvm/nvm.sh" 2>/dev/null; openclaw message send --channel telegram --target "$1" --message "$2"' _ "$chat_id" "$msg" >/dev/null 2>&1
    fi
}

# Kurzer Lebenszeichen-Ping an den Agenten (eigene Session, kurzer Timeout).
# Gibt 0 zurück wenn der Bot grundsätzlich noch antwortet.
_ping_agent() {
    # Dieses Backend antwortet im Normalfall auch bei gesunder Last erst nach
    # 20-65s (siehe owltrail-Log) — ein zu knapper Timeout würde gesunde,
    # nur langsame Anfragen als "hängend" fehlinterpretieren.
    if [ "$WD_DEBUG" = "1" ]; then
        echo -e "${GREY}[watchdog-debug] sende: openclaw agent --session-key agent:main:watchdog-ping --message \"ping\"${NC}"
        local out rc
        out=$(timeout 100 "$OPENCLAW_BIN" agent --agent main --session-key "agent:main:watchdog-ping" \
            --message "ping" --timeout 90 2>&1)
        rc=$?
        echo -e "${GREY}[watchdog-debug] exit=$rc${NC}"
        echo -e "${GREY}[watchdog-debug] Antwort:\n----------------------------------------\n$out\n----------------------------------------${NC}"
        return $rc
    fi
    timeout 100 "$OPENCLAW_BIN" agent --agent main --session-key "agent:main:watchdog-ping" \
        --message "ping" --timeout 90 >/dev/null 2>&1
}

# Stößt die ursprüngliche Aufgabe nach einem Neustart erneut in der gleichen
# Session an — läuft im Hintergrund (kann wieder lange dauern). $1/$2 als
# echte argv-Werte, gleiches Prinzip wie _notify_session.
_reinject_task() {
    local session="$1" task="$2"
    if [ "$BOT_USER" = "$(whoami)" ]; then
        nohup bash -lc 'source "$HOME/.nvm/nvm.sh" 2>/dev/null; openclaw agent --agent main --session-key "$1" --message "$2" --deliver' _ "$session" "$task" >> "$ELLA_WATCHDOG_LOG" 2>&1 &
    else
        sudo -u "$BOT_USER" bash -lc 'source "$HOME/.nvm/nvm.sh" 2>/dev/null; openclaw agent --agent main --session-key "$1" --message "$2" --deliver' _ "$session" "$task" >> "$ELLA_WATCHDOG_LOG" 2>&1 &
    fi
    disown 2>/dev/null
}

# Fuehrt die Wiederaufnahme einer an einem Kontext-Ueberlauf abgestuerzten
# Session aus: Session leeren (wie blitzdings), Fortsetzungs-Prompt (von
# ella-crash-recover.py via Gemma erzeugt) als Master-Task eintragen --
# aber nur, wenn der Aufgabenspeicher frei ist oder schon dieselbe Session
# betrifft (kein versehentliches Ueberschreiben eines fremden Tasks),
# Gateway neu starten, Prompt reinjizieren, Nutzer informieren.
_do_crash_recovery() {
    local session="$1" prompt_file="$2" label="$3" prompt ex_status ex_session
    prompt=$(cat "$prompt_file" 2>/dev/null)
    rm -f "$prompt_file"
    if [ -z "$prompt" ]; then
        _log "Crash-Recovery: leerer Prompt fuer $session, abgebrochen"
        return
    fi
    _log "Crash-Recovery ausgeloest fuer Session $session: $label"
    echo -e "${RED}🚨 Watchdog: Kontext-Ueberlauf erkannt -- Session $session haengt fest.${NC}"
    echo -e "${YELLOW}🧠 Gemma-Analyse: $label${NC}"

    bot_python3 "$BASE_DIR/ella-session-clear.py" "$SESSIONS_DIR" "$session" >> "$ELLA_WATCHDOG_LOG" 2>&1

    local out=$(bot_python3 "$BASE_DIR/ella-task.py" show "$ELLA_TASK_FILE")
    ex_status=$(echo "$out" | grep '^STATUS:' | cut -d: -f2-)
    ex_session=$(echo "$out" | grep '^SESSION:' | cut -d: -f2-)
    if [ "$ex_status" != "in_progress" ] || [ "$ex_session" = "$session" ]; then
        bot_python3 "$BASE_DIR/ella-task.py" set "$ELLA_TASK_FILE" "🚨 Crash-Recovery: $label" "$session" crash_recovery > /dev/null
    else
        _log "Crash-Recovery: Aufgabenspeicher durch anderen Task belegt -- kein Tracking, nur Wiederanstossen"
    fi

    echo -e "${YELLOW}🔄 Starte Gateway neu...${NC}"
    bash "$BASE_DIR/ella-openclaw" restart >> "$ELLA_WATCHDOG_LOG" 2>&1

    local full_prompt="${prompt}

(System-Hinweis: Diese Wiederaufnahme wird automatisch ueberwacht. Ruf bitte regelmaessig \"ella task heartbeat\" auf, waehrend du arbeitest, und \"ella task done\", wenn du fertig bist.)"
    _reinject_task "$session" "$full_prompt"
    _notify_session "$session" "⚠️ Ich bin wegen eines Kontext-Ueberlaufs abgestuerzt. Hab den Verlauf analysiert und mache automatisch weiter: $label"
}

# Prueft, ob die Session seit dem letzten Anstoss (last_nudge_at) ueberhaupt
# eine neue Nachricht bekommen hat. Gibt "NEW" (etwas Neues -> Gemma fragen
# lohnt sich), "SAME" (nichts Neues -> Gemma-Abfrage waere sinnlos) oder
# "UNKNOWN" (im Zweifel wie NEW behandeln) zurueck.
_session_changed_since() {
    local session="$1" last_nudge_at="$2"
    bot_python3 -c "
import datetime, json, os, sys, time

sessions_dir, key, last_nudge_at = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(os.path.join(sessions_dir, 'sessions.json'), encoding='utf-8') as f:
        store = json.load(f)
    sid = store.get(key, {}).get('sessionId')
    if not sid:
        print('UNKNOWN'); sys.exit(0)
    path = os.path.join(sessions_dir, sid + '.jsonl')
    size = os.path.getsize(path)
    with open(path, encoding='utf-8', errors='replace') as f:
        if size > 4000:
            f.seek(size - 4000)
        chunk = f.read()
    last_ts_ms = 0
    for line in reversed([l for l in chunk.strip().split(chr(10)) if l.strip()]):
        try:
            d = json.loads(line)
            ts = d.get('message', {}).get('timestamp') or d.get('timestamp')
            if ts:
                last_ts_ms = int(ts)
                break
        except Exception:
            continue
    if not last_nudge_at:
        print('NEW' if last_ts_ms else 'UNKNOWN'); sys.exit(0)
    nudge_dt = datetime.datetime.fromisoformat(last_nudge_at)
    nudge_ms = time.mktime(nudge_dt.timetuple()) * 1000
    print('NEW' if last_ts_ms > nudge_ms else 'SAME')
except Exception:
    print('UNKNOWN')
" "$SESSIONS_DIR" "$session" "$last_nudge_at" 2>/dev/null
}

# Lässt Gemma anhand der juengsten Nachrichten in der Session beurteilen, ob
# eine automatisch erstellte Aufgabe (Crash-Recovery ODER Bigloop-Nachhaken)
# erledigt ist (DONE/NOT_DONE). Robuster als ein reiner Lebenszeichen-Ping,
# da der Bot bei diesen automatisch reinjizierten Aufgaben ggf. nicht selbst
# an "ella task done" denkt.
_judge_task_done() {
    local session="$1" task="$2" tmp verdict
    tmp=$(bot_run "mktemp -p '$BOT_USER_HOME' .ella_judge_tail_XXXXXX" 2>/dev/null)
    [ -z "$tmp" ] && { echo "NOT_DONE"; return; }
    bot_python3 -c "
import json, os, sys
sessions_dir, key = sys.argv[1], sys.argv[2]
try:
    with open(os.path.join(sessions_dir, 'sessions.json'), encoding='utf-8') as f:
        store = json.load(f)
    sid = store.get(key, {}).get('sessionId')
    if not sid:
        sys.exit(1)
    path = os.path.join(sessions_dir, sid + '.jsonl')
    size = os.path.getsize(path)
    with open(path, encoding='utf-8', errors='replace') as f:
        if size > 12000:
            f.seek(size - 12000)
        sys.stdout.write(f.read())
except Exception:
    sys.exit(1)
" "$SESSIONS_DIR" "$session" > "$tmp" 2>/dev/null
    if [ ! -s "$tmp" ]; then
        bot_run "rm -f '$tmp'" 2>/dev/null
        echo "NOT_DONE"
        return
    fi
    verdict=$(bot_python3 "$BASE_DIR/ella-gemma-assist.py" judge-done "$task" "$tmp" 2>>"$ELLA_WATCHDOG_LOG" | head -1 | tr -d '\r')
    bot_run "rm -f '$tmp'" 2>/dev/null
    echo "${verdict:-NOT_DONE}"
}

case "$SUB" in
    check)
        # --- Bigloop mittickenen lassen -- VOR dem Watchdog-eigenen Gate,
        # da Bigloop ihr eigenes, unabhaengiges An/Aus + Intervall hat (siehe
        # ella-bigloop.py) und sonst nie oefter laufen koennte als der
        # Watchdog selbst (z.B. Bigloop alle 30s, Watchdog alle 300s --
        # ohne diese Trennung waere Bigloop faktisch auf 300s gedeckelt).
        bash "$BASE_DIR/ella-bigloop" check >> "$ELLA_WATCHDOG_LOG" 2>&1

        WD_ENABLED=$(_wd_field enabled True)
        if [ "$WD_ENABLED" = "False" ]; then
            echo -e "${GREY}⏸  Watchdog deaktiviert.${NC}"
            exit 0
        fi

        WD_INTERVAL=$(_wd_field interval_seconds 300)
        WD_LAST_CHECK=$(_wd_field last_check_at "")
        if [ -n "$WD_LAST_CHECK" ]; then
            DUE=$(bot_python3 -c "
import datetime
try:
    last = datetime.datetime.fromisoformat('$WD_LAST_CHECK')
    elapsed = (datetime.datetime.now().astimezone() - last).total_seconds()
    print('yes' if elapsed >= $WD_INTERVAL else 'no')
except Exception:
    print('yes')
" 2>/dev/null)
            if [ "$DUE" = "no" ]; then
                exit 0
            fi
        fi
        _wd_set_field last_check_at "\"$(date -Iseconds)\"" > /dev/null

        # --- Kontext-Ueberlauf-Erkennung (eigenstaendig vom Task-Heartbeat) ---
        # Liest neue Zeilen im Gateway-Log seit dem letzten Check; erkennt
        # Sessions, die wiederholt an "Context is too large" haengen, lässt
        # Gemma einen Fortsetzungs-Prompt erstellen und stoesst die Wiederaufnahme an.
        while IFS=$'\t' read -r KIND_LINE A B C; do
            case "$KIND_LINE" in
                RECOVER) _do_crash_recovery "$A" "$B" "$C" ;;
                GIVEUP)
                    _log "GIVEUP Crash-Recovery fuer Session $A: $B"
                    _notify_session "$A" "❌ Ich bin nach mehreren automatischen Crash-Recovery-Versuchen weiterhin an einem Kontext-Ueberlauf haengen geblieben ($B). Bitte manuell pruefen."
                    ;;
            esac
        done < <(bot_python3 "$BASE_DIR/ella-crash-recover.py" check 2>>"$ELLA_WATCHDOG_LOG")

        OUT=$(bot_python3 "$BASE_DIR/ella-task.py" show "$ELLA_TASK_FILE")
        STATUS=$(echo "$OUT" | grep '^STATUS:' | cut -d: -f2-)

        if [ "$STATUS" != "in_progress" ]; then
            _log "OK — kein aktiver Auftrag (status=$STATUS)"
            echo -e "${GREEN}✅ Watchdog: kein aktiver Auftrag.${NC}"
            if [ "$(_wd_field definitive_mode False)" = "True" ]; then
                echo -e "${GREY}🔎 Definitiv-Modus: prüfe Lebenszeichen direkt...${NC}"
                if _ping_agent; then
                    _log "Definitiv-Ping erfolgreich (kein aktiver Auftrag)"
                else
                    _log "Definitiv-Ping OHNE Antwort (kein aktiver Auftrag) — starte Gateway neu"
                    echo -e "${RED}🚨 Definitiv-Modus: Bot antwortet nicht — starte Gateway neu.${NC}"
                    bash "$BASE_DIR/ella-openclaw" restart >> "$ELLA_WATCHDOG_LOG" 2>&1
                fi
            fi
            exit 0
        fi

        TASK=$(echo "$OUT" | grep '^TASK:' | cut -d: -f2-)
        SESSION=$(echo "$OUT" | grep '^SESSION:' | cut -d: -f2-)
        AGE=$(echo "$OUT" | grep '^HEARTBEAT_AGE_MIN:' | cut -d: -f2-)
        RETRY_COUNT=$(echo "$OUT" | grep '^RETRY_COUNT:' | cut -d: -f2-)
        RETRY_COUNT="${RETRY_COUNT:-0}"
        KIND=$(echo "$OUT" | grep '^KIND:' | cut -d: -f2-)
        LAST_NUDGE_AT=$(echo "$OUT" | grep '^LAST_NUDGE_AT:' | cut -d: -f2-)
        MAX_RETRIES="${ELLA_WATCHDOG_MAX_RETRIES:-2}"
        EFFECTIVE_STALE_MIN="$STALE_MIN"
        case "$KIND" in
            crash_recovery|bigloop_followup) EFFECTIVE_STALE_MIN="$RECOVERY_STALE_MIN" ;;
        esac

        if [ -z "$AGE" ] || [ "$AGE" -lt 0 ]; then
            _log "WARN — Task aktiv, aber kein Heartbeat-Zeitstempel lesbar"
            exit 0
        fi

        if [ "$AGE" -lt "$EFFECTIVE_STALE_MIN" ]; then
            _log "OK — Bot arbeitet, Heartbeat vor ${AGE}m (Schwelle ${EFFECTIVE_STALE_MIN}m): $TASK"
            echo -e "${GREEN}✅ Watchdog: Bot arbeitet noch (Heartbeat vor ${AGE} Min.).${NC}"
            exit 0
        fi

        # --- Automatisch erstellte Aufgaben (Bigloop/Crash-Recovery): kein
        # generischer Ping auf eine fremde Test-Session -- stattdessen ein
        # viel praeziseres Signal: gab es seit dem letzten Anstoss UEBERHAUPT
        # neue Aktivitaet in GENAU dieser Session? Wenn nein, ist eine
        # Gemma-Abfrage sinnlos (nichts zu bewerten) -- direkt erneut anstossen.
        # Wenn ja, erst dann Gemma fragen, ob's jetzt erledigt ist.
        if [ "$KIND" = "crash_recovery" ] || [ "$KIND" = "bigloop_followup" ]; then
            CHANGED=$(_session_changed_since "$SESSION" "$LAST_NUDGE_AT")
            if [ "$CHANGED" = "SAME" ]; then
                _log "Keine neue Aktivitaet seit letztem Anstoss in $SESSION -- Gemma-Abfrage uebersprungen."
                echo -e "${YELLOW}⏱  Seit dem letzten Anstoß ist nichts Neues passiert — stoße direkt erneut an.${NC}"
            else
                VERDICT=$(_judge_task_done "$SESSION" "$TASK")
                if [ "$VERDICT" = "DONE" ]; then
                    bot_python3 "$BASE_DIR/ella-task.py" done "$ELLA_TASK_FILE" > /dev/null
                    _log "Automatische Aufgabe ($KIND) laut Gemma erledigt: $TASK"
                    echo -e "${GREEN}✅ Watchdog: Aufgabe laut Gemma erledigt.${NC}"
                    exit 0
                fi
                _log "Automatische Aufgabe ($KIND) laut Gemma noch nicht fertig (oder kein Urteil moeglich): $TASK"
            fi

            # Gateway neu starten ist hier Pflicht, nicht Option: ohne
            # Heartbeat koennen wir nicht unterscheiden zwischen "Session
            # schläft wirklich" und "inferiert noch, hat nur kein Heartbeat
            # gesendet" -- ein Neustart beendet eine evtl. noch laufende
            # Inferenz sicher, bevor wir erneut reinjizieren (sonst Risiko
            # eines Session-Locking-Konflikts wie beim blitzdings-Bug).
            echo -e "${YELLOW}🔄 Starte Gateway neu...${NC}"
            bash "$BASE_DIR/ella-openclaw" restart >> "$ELLA_WATCHDOG_LOG" 2>&1
            if [ "$RETRY_COUNT" -lt "$MAX_RETRIES" ] && [ -n "$SESSION" ] && [ "$SESSION" != "?" ] && [ -n "$TASK" ]; then
                NEW_COUNT=$(bot_python3 "$BASE_DIR/ella-task.py" retry "$ELLA_TASK_FILE")
                _log "Stoße automatische Aufgabe erneut an (Versuch ${NEW_COUNT}/${MAX_RETRIES})."
                echo -e "${YELLOW}🔁 Stoße erneut an (Versuch ${NEW_COUNT}/${MAX_RETRIES})...${NC}"
                # Sichtbar im Chat posten, WAS gerade (erneut) angewiesen wird --
                # sonst sieht man im Verlauf nur Klauskis Reaktion, nicht den
                # eigentlichen (Zwischen-)Auftrag, den das System gerade durchsetzt.
                _notify_session "$SESSION" "🔁 [Automatischer Anstoß, Versuch ${NEW_COUNT}/${MAX_RETRIES}] $TASK"
                _reinject_task "$SESSION" "$TASK"
            else
                bot_python3 "$BASE_DIR/ella-task.py" fail "$ELLA_TASK_FILE" > /dev/null
                _log "Max. Versuche (${MAX_RETRIES}) erreicht — gebe auf, kein weiterer Auto-Retry."
                _notify_session "$SESSION" "❌ Ich komme bei \"$TASK\" nach ${MAX_RETRIES} automatischen Versuchen nicht weiter. Bitte manuell prüfen."
            fi
            exit 0
        fi

        echo -e "${YELLOW}⏱  Heartbeat seit ${AGE} Min. überfällig (Schwelle ${EFFECTIVE_STALE_MIN}m). Bestätige per Ping...${NC}"
        if _ping_agent; then
            _log "Heartbeat überfällig (${AGE}m), aber Ping erfolgreich -> kein Neustart. Task: $TASK"
            echo -e "${YELLOW}⚠️  Bot reagiert noch auf Ping — kein Neustart, nur Beobachtung.${NC}"
            exit 0
        fi

        # --- STUCK erkannt: Heartbeat überfällig UND Ping ohne Antwort ---
        _log "STUCK erkannt — kein Heartbeat seit ${AGE}m, Ping ohne Antwort. Task: $TASK Session: $SESSION (Versuch ${RETRY_COUNT}/${MAX_RETRIES})"
        echo -e "${RED}🚨 Watchdog: Bot hängt seit ${AGE} Min. bei: $TASK${NC}"

        echo -e "${YELLOW}🔄 Starte Gateway neu...${NC}"
        bash "$BASE_DIR/ella-openclaw" restart >> "$ELLA_WATCHDOG_LOG" 2>&1

        if [ "$RETRY_COUNT" -lt "$MAX_RETRIES" ] && [ -n "$SESSION" ] && [ "$SESSION" != "?" ] && [ -n "$TASK" ]; then
            NEW_COUNT=$(bot_python3 "$BASE_DIR/ella-task.py" retry "$ELLA_TASK_FILE")
            _log "Gateway neu gestartet. Stoße Aufgabe automatisch erneut an (Versuch ${NEW_COUNT}/${MAX_RETRIES})."
            echo -e "${YELLOW}🔁 Stoße Aufgabe erneut an (Versuch ${NEW_COUNT}/${MAX_RETRIES})...${NC}"
            _reinject_task "$SESSION" "$TASK"
            _notify_session "$SESSION" "⚠️ Ich bin bei \"$TASK\" hängen geblieben (kein Lebenszeichen seit ${AGE} Min.). Hab mich neu gestartet und versuche es automatisch erneut (Versuch ${NEW_COUNT}/${MAX_RETRIES})."
        else
            bot_python3 "$BASE_DIR/ella-task.py" fail "$ELLA_TASK_FILE" > /dev/null
            _log "Max. Versuche (${MAX_RETRIES}) erreicht oder Session/Task unbekannt — gebe auf, kein weiterer Auto-Retry."
            if [ -n "$SESSION" ] && [ "$SESSION" != "?" ]; then
                _notify_session "$SESSION" "❌ Ich bin bei \"$TASK\" wiederholt hängen geblieben und gebe nach ${MAX_RETRIES} automatischen Versuchen auf. Gateway wurde neu gestartet — bitte manuell prüfen."
            fi
        fi
        ;;

    on)
        _wd_set_field enabled True > /dev/null
        echo -e "${GREEN}✅ Watchdog aktiviert.${NC}"
        ;;

    off)
        _wd_set_field enabled False > /dev/null
        echo -e "${YELLOW}⏸  Watchdog deaktiviert.${NC}"
        ;;

    interval)
        case "$1" in
            *h) SEC=$(( ${1%h} * 3600 )) ;;
            *m) SEC=$(( ${1%m} * 60 )) ;;
            [0-9]*) SEC="$1" ;;
            *) SEC="" ;;
        esac
        if [ -z "$SEC" ]; then
            echo -e "${RED}Usage: ella watchdog interval <sekunden|Nm|Nh>  (z.B. 300, 5m, 1h)${NC}"
            exit 1
        fi
        _wd_set_field interval_seconds "$SEC" > /dev/null
        echo -e "${GREEN}✅ Watchdog-Intervall: ${SEC}s${NC}"
        ;;

    definitive)
        case "$1" in
            on)  _wd_set_field definitive_mode True > /dev/null
                 echo -e "${GREEN}✅ Definitiv-Modus aktiviert — pingt den Bot bei jedem Check direkt an.${NC}" ;;
            off) _wd_set_field definitive_mode False > /dev/null
                 echo -e "${YELLOW}⏸  Definitiv-Modus deaktiviert.${NC}" ;;
            *)   echo -e "${RED}Usage: ella watchdog definitive on|off${NC}"; exit 1 ;;
        esac
        ;;

    status)
        WD_ENABLED_S=$(_wd_field enabled True)
        WD_INTERVAL_S=$(_wd_field interval_seconds 300)
        WD_DEFINITIVE_S=$(_wd_field definitive_mode False)
        echo -e "${BLUE}${BOLD}🐕 Watchdog Status${NC}"
        if [ "$WD_ENABLED_S" = "True" ]; then
            echo -e "  Status:        ${GREEN}aktiv${NC}"
        else
            echo -e "  Status:        ${GREY}deaktiviert${NC}  (an mit: ella watchdog on)"
        fi
        echo -e "  Intervall:     ${WD_INTERVAL_S}s"
        if [ "$WD_DEFINITIVE_S" = "True" ]; then
            echo -e "  Definitiv-Modus: ${GREEN}aktiv${NC} (pingt den Bot bei jedem Check direkt an)"
        else
            echo -e "  Definitiv-Modus: ${GREY}aus${NC}"
        fi
        echo -e "  ${GREY}Schwelle: ${STALE_MIN} Min. ohne Heartbeat + Ping ohne Antwort = hängend${NC}"
        echo
        bash "$BASE_DIR/ella-task" show
        echo
        if [ -f "$ELLA_WATCHDOG_LOG" ]; then
            echo -e "${BOLD}Letzte Watchdog-Einträge:${NC}"
            tail -n 5 "$ELLA_WATCHDOG_LOG" | sed "s/^/  ${GREY}/;s/\$/${NC}/"
        fi
        ;;

    log)
        if [ -f "$ELLA_WATCHDOG_LOG" ]; then
            tail -f "$ELLA_WATCHDOG_LOG"
        else
            echo -e "${GREY}Noch kein Watchdog-Log vorhanden: $ELLA_WATCHDOG_LOG${NC}"
        fi
        ;;

    install)
        echo -e "${CYAN}🐕 Installiere Watchdog-Timer (systemd --user, Tick alle 60s)...${NC}"
        echo -e "${GREY}   Tatsaechliche Pruef-Haeufigkeit von Watchdog UND Bigloop folgt ihren${NC}"
        echo -e "${GREY}   eigenen Intervallen (ella watchdog interval / ella bigloop interval) --${NC}"
        echo -e "${GREY}   der 60s-Tick ist nur die feinste moegliche Aufloesung dafuer.${NC}"
        UNIT_DIR="$BOT_USER_HOME/.config/systemd/user"
        bot_run "mkdir -p '$UNIT_DIR'"

        SERVICE_CONTENT="[Unit]
Description=Ella Watchdog Check

[Service]
Type=oneshot
Environment=HOME=$BOT_USER_HOME
ExecStart=/bin/bash -lc \"source $BOT_USER_HOME/.nvm/nvm.sh 2>/dev/null; $BASE_DIR/ella-watchdog check\"
# WICHTIG: Default ist KillMode=control-group -- damit wuerde systemd nach
# Skriptende die GESAMTE Prozessgruppe killen, auch im Hintergrund
# gestartete Reinject-/Notify-Aufrufe (nohup/disown schuetzen davor NICHT,
# das wirkt nur gegen Signale vom Terminal, nicht gegen Cgroup-Kills).
# KillMode=process killt nur den direkt gestarteten Bash-Prozess.
KillMode=process
"
        TIMER_CONTENT="[Unit]
Description=Ella Watchdog Timer (Tick alle 60s, eigentliches Intervall via 'ella watchdog interval')

[Timer]
OnBootSec=1min
OnUnitActiveSec=60s
Persistent=true

[Install]
WantedBy=timers.target
"
        bot_python3 -c "import sys; open(sys.argv[1], 'w').write(sys.argv[2])" "$UNIT_DIR/ella-watchdog.service" "$SERVICE_CONTENT"
        bot_python3 -c "import sys; open(sys.argv[1], 'w').write(sys.argv[2])" "$UNIT_DIR/ella-watchdog.timer" "$TIMER_CONTENT"

        bot_run "export XDG_RUNTIME_DIR=/run/user/\$(id -u); systemctl --user daemon-reload && systemctl --user enable --now ella-watchdog.timer"
        echo -e "${GREEN}✅ Watchdog-Timer installiert und aktiv.${NC}"
        bot_run "export XDG_RUNTIME_DIR=/run/user/\$(id -u); systemctl --user list-timers ella-watchdog.timer --no-pager" 2>/dev/null
        ;;

    --help|-h)
        echo -e "${BLUE}${BOLD}🐕 ELLA WATCHDOG${NC}"
        echo -e "${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "  ${GREEN}ella watchdog on/off${NC}         An-/Ausschalten (Standard: an)"
        echo -e "  ${GREEN}ella watchdog interval <n>${NC}   Pruef-Intervall (Sekunden, oder 5m/1h) — Standard 300s"
        echo -e "  ${GREEN}ella watchdog definitive on/off${NC}  Bei jedem Check direkt eine echte Ping-Nachricht senden"
        echo -e "                                  (statt nur Prozess/Port zu pruefen) — sicherer, aber kostet Token"
        echo -e "  ${GREEN}ella watchdog check${NC}          Einmaliger Check (auch vom Timer genutzt)"
        echo -e "  ${GREEN}ella watchdog status${NC}         Konfiguration + aktueller Task + letzte Einträge"
        echo -e "  ${GREEN}ella watchdog log${NC}            Live-Log"
        echo -e "  ${GREEN}ella watchdog install${NC}        Timer installieren (Tick 60s, persistent über Reboot)"
        echo -e "${GREY}  Bei Hänger: Neustart + automatischer Retry (max. ${ELLA_WATCHDOG_MAX_RETRIES:-2}x, dann Aufgabe -> failed)${NC}"
        echo -e "${GREY}  Bigloop (eigenstaendige Session-Review-Schleife): ella bigloop --help${NC}"
        ;;

    *)
        echo -e "${RED}❌ Unbekannter watchdog-Befehl: $SUB${NC}"
        echo -e "   ella watchdog --help"
        exit 1
        ;;
esac
