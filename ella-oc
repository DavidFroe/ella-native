#!/usr/bin/env bash
# Wrapper: findet und fuehrt openclaw aus, auch wenn es im PATH des
# aufrufenden Prozesses fehlt (z.B. interaktive Shell ohne nvm/npm-global
# im PATH). Wechselt NUR dann den User, wenn BOT_USER explizit in
# ella.conf auf einen ANDEREN Account als den aktuellen gesetzt ist
# (Admin verwaltet einen separaten Bot-Account, wie bei klauski) --
# auf Single-User-Systemen bleibt es der aktuelle User.
BASE_DIR=$(dirname "$(readlink -f "$0")")
[ -f "$BASE_DIR/ella.conf" ] && source "$BASE_DIR/ella.conf"
BOT_USER="${BOT_USER:-$(whoami)}"

# In dieser Subshell ausgefuehrt -- versucht nvm UND npm-global, je
# nachdem wie openclaw auf der jeweiligen Maschine installiert wurde.
RUN='
    source "$HOME/.nvm/nvm.sh" 2>/dev/null
    export PATH="$HOME/.npm-global/bin:$PATH"
    openclaw "$@"
'

if [ "$BOT_USER" = "$(whoami)" ]; then
    exec bash -c "$RUN" -- "$@"
else
    exec sudo -u "$BOT_USER" bash -c "$RUN" -- "$@"
fi
