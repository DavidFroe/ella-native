BASE_DIR=$(dirname "$(readlink -f "$0")")
source $BASE_DIR/ella-core

COMMAND="$1"
PARAM2="$2"

if command -v require_container >/dev/null 2>&1; then
    require_container
fi

# Helper: Run openclaw command (inside or outside container)
oc_run() {
    if command -v is_inside >/dev/null 2>&1 && is_inside; then
        eval "$@"
    elif command -v podman >/dev/null 2>&1; then
        podman exec --user david "$CONTAINER_NAME" bash -lc "$*"
    else
        eval "$@"
    fi
}

# owlAPI-Modelle von localhost:4040
OWLAPI_URL="http://localhost:4040"

get_owlapi_models() {
    curl -s --max-time 3 "$OWLAPI_URL/models" 2>/dev/null | python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    for m in data.get("models", []):
        mid = m.get("id", "?")
        name = m.get("name", "")
        prov = m.get("provider", "?")
        ctx = m.get("context_window", 0)
        if isinstance(ctx, int) and ctx >= 1048576:
            ctx_s = f"{int(ctx/1048576)}M"
        elif isinstance(ctx, int) and ctx >= 1024:
            ctx_s = f"{int(ctx/1024)}k"
        else:
            ctx_s = str(ctx)
        print(f"owlapi/{mid}|{name}|{prov}|{ctx_s}")
except: pass
' 2>/dev/null
}

# Alle verfügbaren Models auflisten (nur Modellnamen, ohne Header)
get_model_list() {
    # OpenClaw Models
    oc_run "openclaw models list --all 2>/dev/null" \
        | sed -e 's/\x1b\[[0-9;]*m//g' \
        | grep -v '^\s*$' \
        | tail -n +2 \
        | awk '{print $1}'
    # owlAPI Models
    get_owlapi_models | cut -d'|' -f1
}

# Aktuelles Model = das mit "default" Tag
get_current_model() {
    oc_run "openclaw models list --all 2>/dev/null" \
        | sed -e 's/\x1b\[[0-9;]*m//g' \
        | grep "default" \
        | awk '{print $1}'
}

# Vollständige Zeile für Anzeige
get_model_details() {
    oc_run "openclaw models list --all 2>/dev/null" \
        | sed -e 's/\x1b\[[0-9;]*m//g' \
        | grep -v '^\s*$' \
        | tail -n +2
}

# Alle verfügbaren Anbieter (Kategorien) auflisten
get_categories() {
    get_model_list | cut -d'/' -f1 | sort -u
}

# Models einer bestimmten Kategorie auflisten
get_models_by_category() {
    local CAT="$1"
    if [ "$CAT" = "owlapi" ]; then
        # Spezielles Format für owlapi
        get_owlapi_models | while IFS='|' read -r fullid name prov ctx; do
            echo "$fullid  $name ($prov, ctx:$ctx)"
        done
        return
    fi
    get_model_details | grep -i "^$CAT/"
}

list_models() {
    local CAT="$1"

    if [ -z "$CAT" ]; then
        echo -e "${BLUE}🤖 VERFÜGBARE MODELLE:${NC}"
        echo -e "${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        CURRENT=$(get_current_model)

        # OpenClaw Modelle
        get_categories | while read -r provider; do
            if [ "$provider" = "owlapi" ]; then
                continue  # owlapi separat unten
            fi
            count=$(get_model_list | grep -c "^$provider/")
            echo -e "  ${BOLD}${CYAN}[$provider]${NC} ($count Modelle)"
            get_model_details | grep -i "^$provider/" | while IFS= read -r line; do
                MODEL_NAME=$(echo "$line" | awk '{print $1}')
                TAGS=$(echo "$line" | awk '{print $NF}')
                [ -z "$MODEL_NAME" ] && continue
                if echo "$TAGS" | grep -q "default"; then
                    echo -e "    ${GREEN}${BOLD}★ $MODEL_NAME  (AKTIV)${NC}"
                elif echo "$TAGS" | grep -q "missing"; then
                    echo -e "    ${RED}  $MODEL_NAME  ⚠ MISSING${NC}"
                else
                    echo -e "    ${CYAN}•${NC} $MODEL_NAME"
                fi
            done
        done

        # owlAPI Modelle mit Namen
        OWL_MODELS=$(get_owlapi_models 2>/dev/null)
        if [ -n "$OWL_MODELS" ]; then
            OWL_COUNT=$(echo "$OWL_MODELS" | wc -l)
            echo -e "  ${BOLD}${CYAN}[owlapi]${NC} ($OWL_COUNT Modelle)"
            echo "$OWL_MODELS" | while IFS='|' read -r fullid name prov ctx; do
                id_short="${fullid#owlapi/}"
                if [ -z "$name" ] || [ "$name" = "$id_short" ]; then
                    echo -e "    ${CYAN}•${NC} ${fullid}  ${GREY}($prov, ctx:$ctx)${NC}"
                else
                    echo -e "    ${CYAN}•${NC} ${fullid}  ${YELLOW}${name}${NC}  ${GREY}($prov, ctx:$ctx)${NC}"
                fi
            done
        fi

        echo -e "${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "  Aktiv: ${YELLOW}${CURRENT:-Unbekannt}${NC}"
        echo -e "${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${CYAN}Wechseln: ella --models set <name>${NC}"
        return
    fi

    echo -e "${BLUE}🤖 MODELLE IN KATEGORIE: ${BOLD}$CAT${NC}"
    echo -e "${GREY}-----------------------------------------${NC}"

    local i=1
    get_models_by_category "$CAT" | while IFS= read -r line; do
        MODEL_NAME=$(echo "$line" | awk '{print $1}')
        TAGS=$(echo "$line" | awk '{print $NF}')
        [ -z "$MODEL_NAME" ] && continue

        if echo "$TAGS" | grep -q "default"; then
            echo -e "  ${GREEN}${BOLD}★ $MODEL_NAME  (AKTIV)${NC}"
        elif echo "$TAGS" | grep -q "missing"; then
            echo -e "  ${RED}  $MODEL_NAME  ⚠ MISSING${NC}"
        else
            echo -e "  ${CYAN}•${NC} $MODEL_NAME"
        fi
        i=$((i + 1))
    done

    echo -e "${GREY}-----------------------------------------${NC}"
    echo -e "${CYAN}Wechseln: ella --models set <name>${NC}"
}

# Model per Nummer oder Name setzen
set_model() {
    local TARGET="$1"
    
    if [ -z "$TARGET" ]; then
        echo -e "${RED}❌ Modellname fehlt!${NC}"
        echo -e "Nutze: ${CYAN}ella --models set <name>${NC}"
        return 1
    fi
    
    # Spezialfall: owlapi Modelle → OpenClaw auf owltrail umstellen
    if [[ "$TARGET" == "owlapi" ]] || [[ "$TARGET" == owlapi/* ]]; then
        local OWL_MODEL_ID="${TARGET#owlapi}"
        OWL_MODEL_ID="${OWL_MODEL_ID#/}"  # Strip leading /
        [ -z "$OWL_MODEL_ID" ] && OWL_MODEL_ID="auto"  # Default: Triage
        echo -e "${BLUE}🦉 Konfiguriere Ella für owlAPI (Triage: $OWL_MODEL_ID)${NC}"
        echo -e "   Route: Ella → owltrail (:8081) → owlAPI (:4040) → Backend"
        
        # Provider in openclaw.json eintragen 
        RESULT=$(python3 -c "
import json, os
conf = os.environ.get('OPENCLAW_JSON_PATH', os.path.expanduser('~/.openclaw/openclaw.json'))
try:
    with open(conf) as f: data = json.load(f)
except Exception:
    data = {}

# Ensure models structure exists
if 'models' not in data: data['models'] = {}
if 'providers' not in data['models']: data['models']['providers'] = {}

# Add our custom provider
data['models']['providers']['custom-localhost-8081'] = {
    'baseUrl': 'http://localhost:8081/v1',
    'models': [{'id': '$OWL_MODEL_ID', 'name': '$OWL_MODEL_ID'}]
}

with open(conf, 'w') as f: json.dump(data, f, indent=2)
print('OK')
" 2>&1)

        if echo "$RESULT" | grep -q "OK"; then
            RESULT=$(oc_run "openclaw models set 'custom-localhost-8081/$OWL_MODEL_ID' 2>&1")
            if [ $? -eq 0 ] && ! echo "$RESULT" | grep -qi "error"; then
                echo -e "${GREEN}✅ Ella nutzt jetzt owlAPI Modell: ${BOLD}$OWL_MODEL_ID${NC}"
                echo -e "${GREY}   Route: Ella → owltrail (:8081) → owlAPI (:4040) → Backend${NC}"
                echo -e "${CYAN}   Tipp: owltrail server start  (falls nicht läuft)${NC}"
                return
            fi
        fi
        
        echo -e "${RED}❌ Fehler bei der Konfiguration: $RESULT${NC}"
        return
    fi
    
    MODEL_NAME="$TARGET"
    
    echo -e "${BLUE}🔄 Wechsle zu: ${BOLD}$MODEL_NAME${NC}"
    
    # Methode 1: openclaw models set
    RESULT=$(oc_run "openclaw models set '$MODEL_NAME' 2>&1")
    RET=$?
    
    if [ $RET -ne 0 ] || echo "$RESULT" | grep -qi "error\|unknown"; then
        # Methode 2: Config-Datei korrekt editieren
        echo -e "${YELLOW}⚙️  Direkte Config-Änderung (agents.defaults.model.primary)...${NC}"
        RESULT=$(oc_run "python3 -c \"
import json, os
conf = os.environ.get('OPENCLAW_JSON_PATH', '/home/david/.openclaw/openclaw.json')
with open(conf) as f: data = json.load(f)
data.setdefault('agents', {}).setdefault('defaults', {}).setdefault('model', {})['primary'] = '$MODEL_NAME'
data.get('agents', {}).get('defaults', {}).get('model', {}).pop('fallbacks', None)
with open(conf, 'w') as f: json.dump(data, f, indent=2)
print('OK')
\" 2>&1")
        RET=$?
    fi
    
    if [ $RET -eq 0 ] && ! echo "$RESULT" | grep -qi "error"; then
        echo -e "${GREEN}✅ Model gewechselt: ${BOLD}$MODEL_NAME${NC}"
        echo -e "${GREY}Tipp: ella --sessions reset falls der Agent nicht reagiert.${NC}"
    else
        echo -e "${RED}❌ Fehler: $RESULT${NC}"
        echo -e "${YELLOW}Tipp: Versuche im Container: openclaw configure${NC}"
    fi
}

# --- MAIN ---
case "$COMMAND" in
    ""|"list")
        list_models "$PARAM2"
        ;;
    "set")
        set_model "$PARAM2"
        ;;
    "current"|"active")
        CURRENT=$(get_current_model)
        echo -e "🤖 Aktives Model: ${GREEN}${BOLD}${CURRENT:-Unbekannt}${NC}"
        ;;
    "fix"|"doctor")
        echo -e "${YELLOW}🔧 Repariere Config...${NC}"
        oc_run "openclaw doctor --fix"
        ;;
    *)
        # Falls ein Argument direkt kommt (z.B. ella --models openai/gpt-4)
        if get_model_list | grep -qx "$COMMAND"; then
            set_model "$COMMAND"
        else
            list_models "$COMMAND"
        fi
        ;;
esac
