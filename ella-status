BASE_DIR=$(dirname "$(readlink -f "$0")")
source $BASE_DIR/ella-core

echo -e "${BLUE}📊 --- ELLA-PI MASTER STATUS (v${ELLA_VERSION}) ---${NC}"
echo -e "${GREY}------------------------------------------------------------${NC}"

# 1. PROCESS STATUS
echo -e "${MAGENTA}🌀 ACTIVE PROCESSES:${NC}"
GW_PID=$(pgrep -f "openclaw gateway|openclaw-gateway" | head -1)
[ -n "$GW_PID" ] && echo -e "  🛰️  Gateway:    ${GREEN}RUNNING (PID $GW_PID)${NC}" || echo -e "  🛰️  Gateway:    ${RED}OFFLINE${NC}"

OWL_PID=$(pgrep -f "owltrail_server" | head -1)
if [ -z "$OWL_PID" ]; then
    # Fallback: HTTP health check
    OWL_HTTP=$(curl -s -o /dev/null -w "%{http_code}" --max-time 2 "http://127.0.0.1:$OWLTRAIL_PORT/v1/models" 2>/dev/null)
    if [ "$OWL_HTTP" = "200" ]; then
        echo -e "  🦉 owltrail:   ${GREEN}RUNNING (HTTP OK)${NC}"
    else
        echo -e "  🦉 owltrail:   ${RED}OFFLINE${NC}"
    fi
else
    echo -e "  🦉 owltrail:   ${GREEN}RUNNING (PID $OWL_PID)${NC}"
fi

# 2. SYSTEM RESOURCES
echo -e "\n${MAGENTA}📈 SYSTEM LOAD:${NC}"
CPU_LOAD=$(top -bn1 | grep "Cpu(s)" | awk '{print $2 + $4}')"%"
RAM_FREE=$(free -m | awk '/Mem:/ { printf "%0.2f%%", $3/$2*100 }')
echo -e "  🧠 CPU:         ${YELLOW}$CPU_LOAD${NC}"
echo -e "  💾 RAM:         ${YELLOW}$RAM_FREE${NC}"

# 3. OPENCLAW STATUS
echo -e "\n${MAGENTA}🧠 AGENT PROFILE:${NC}"
OC_STATUS=$(timeout 15 $OPENCLAW_BIN status --all 2>/dev/null | sed -e 's/\x1b\[[0-9;]*m//g')
if [ -n "$OC_STATUS" ]; then
    OC_VERSION=$(echo "$OC_STATUS" | grep -E '│\s+Version\s+│' | awk -F '│' '{print $3}' | xargs)
    OC_AGENTS=$(echo "$OC_STATUS" | grep -E '│\s+Agents\s+│' | awk -F '│' '{print $3}' | xargs)
    OC_CHANNELS=$(echo "$OC_STATUS" | awk -F '│' '/ON/ && /OK/ {print $2}' | xargs | sed 's/ /, /g')
    
    echo -e "  ✨ Version:    ${CYAN}${OC_VERSION:-?}${NC}"
    echo -e "  🤖 Agents:     ${CYAN}${OC_AGENTS:-?}${NC}"
    echo -e "  📡 Channels:   ${GREEN}${OC_CHANNELS:-Keine aktiven Kanäle}${NC}"
else
    echo -e "  ${RED}OpenClaw Gateway antwortet nicht.${NC}"
fi

# 4. SESSIONS
echo -e "\n${MAGENTA}💬 LATEST SESSIONS:${NC}"
SESSIONS=$($OPENCLAW_BIN sessions 2>/dev/null | grep -E '^(direct|group)' | head -3)
if [ -n "$SESSIONS" ]; then
    echo "$SESSIONS"
else
    echo -e "  ${GREY}(Keine aktiven Sessions)${NC}"
fi

echo -e "${GREY}------------------------------------------------------------${NC}"
check_gw_http && echo -e "${GREEN}${BOLD}✅ RESULT: Ella-Pi Status OK${NC}" || echo -e "${RED}${BOLD}❌ RESULT: Ella-Pi Status ERROR${NC}"
