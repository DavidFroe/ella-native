#!/usr/bin/env bash
# ================================================================
# ELLA SKILLS — Skills im Bot-Workspace ansehen, anlegen, bearbeiten,
# löschen.
#
# Skills sind Markdown-Ordner unter ~/.openclaw/workspace/skills/<name>/
# SKILL.md, die der Bot je nach Situation selbst zieht. Dieses Kommando
# macht sie von der CLI aus verwaltbar, statt sie nur per Hand im
# Dateisystem anzufassen.
# ================================================================
BASE_DIR=$(dirname "$(readlink -f "$0")")
source "$BASE_DIR/ella-core"

SKILLS_DIR="$BOT_USER_HOME/.openclaw/workspace/skills"
SUB="${1:-list}"
shift 2>/dev/null
NAME="$1"

case "$SUB" in
    list|ls|show_all)
        VERBOSE="0"
        if [ "$NAME" = "-v" ] || [ "$NAME" = "--all" ]; then
            VERBOSE="1"
        fi
        echo -e "${BLUE}${BOLD}🧩 Skills (Workspace + fest eingebaut)${NC}"
        bot_python3 -c "
import json, subprocess

GREEN='\033[32m'; GREY='\033[90m'; YELLOW='\033[33m'; RED='\033[31m'; R='\033[0m'; BOLD='\033[1m'

verbose = '$VERBOSE' == '1'

try:
    out = subprocess.run(['$OPENCLAW_BIN', 'skills', 'list', '--json'],
                          capture_output=True, text=True, timeout=20).stdout
    skills = json.loads(out).get('skills', [])
except Exception as e:
    print(f'{RED}❌ Konnte Skill-Liste nicht laden: {e}{R}')
    skills = []

def row(s):
    status = f'{GREEN}✓ aktiv{R}' if s.get('eligible') else f'{GREY}△ Setup nötig{R}'
    emoji = s.get('emoji') or '🧩'
    print(f'  {emoji} {BOLD}{s[\"name\"]}{R}  [{status}]')
    desc = s.get('description', '')
    if desc:
        print(f'      {GREY}{desc[:110]}{R}')
    if verbose and not s.get('eligible'):
        m = s.get('missing', {}) or {}
        need = []
        if m.get('bins'): need.append('Programme: ' + ', '.join(m['bins']))
        if m.get('env'): need.append('Env-Vars: ' + ', '.join(m['env']))
        if m.get('config'): need.append('Config: ' + ', '.join(m['config']))
        if need:
            print(f'      {YELLOW}braucht: {\"; \".join(need)}{R}')

by_source = {}
for s in skills:
    by_source.setdefault(s.get('source', '?'), []).append(s)

ws = sorted(by_source.get('openclaw-workspace', []), key=lambda x: x['name'])
print(f'{BOLD}Eigene Skills (Workspace):{R}')
if not ws:
    print(f'  {GREY}Keine — ella skills create <name> zum Anlegen.{R}')
for s in ws:
    row(s)

bundled = by_source.get('openclaw-bundled', []) + by_source.get('openclaw-extra', [])
ready = sorted([s for s in bundled if s.get('eligible')], key=lambda x: x['name'])
not_ready = sorted([s for s in bundled if not s.get('eligible')], key=lambda x: x['name'])

print(f'\n{BOLD}Fest eingebaut, sofort einsatzbereit ({len(ready)}):{R}')
for s in ready:
    row(s)

print(f'\n{GREY}+ {len(not_ready)} weitere fest eingebaute Skills brauchen noch Setup (CLI-Tool/Token/Config).{R}')
if not verbose:
    print(f'{GREY}  Details dazu: ella skills list -v{R}')
else:
    for s in not_ready:
        row(s)
"
        ;;

    show|cat)
        if [ -z "$NAME" ]; then
            echo -e "${RED}Usage: ella skills show <name>${NC}"
            exit 1
        fi
        if bot_run "[ -f '$SKILLS_DIR/$NAME/SKILL.md' ]"; then
            bot_run "cat '$SKILLS_DIR/$NAME/SKILL.md'"
        else
            echo -e "${RED}❌ Skill '$NAME' nicht gefunden.${NC}"
            exit 1
        fi
        ;;

    edit)
        if [ -z "$NAME" ]; then
            echo -e "${RED}Usage: ella skills edit <name>${NC}"
            exit 1
        fi
        bot_run "mkdir -p '$SKILLS_DIR/$NAME'"
        EDITOR_BIN="${EDITOR:-nano}"
        if [ "$BOT_USER" = "$(whoami)" ]; then
            "$EDITOR_BIN" "$SKILLS_DIR/$NAME/SKILL.md"
        else
            sudo -u "$BOT_USER" "$EDITOR_BIN" "$SKILLS_DIR/$NAME/SKILL.md"
        fi
        echo -e "${GREEN}✅ Skill gespeichert: $NAME${NC}"
        ;;

    create|new)
        if [ -z "$NAME" ]; then
            echo -e "${RED}Usage: ella skills create <name>${NC}"
            exit 1
        fi
        if bot_run "[ -f '$SKILLS_DIR/$NAME/SKILL.md' ]"; then
            echo -e "${YELLOW}⚠️  Skill '$NAME' existiert schon — nutze 'ella skills edit $NAME'.${NC}"
            exit 1
        fi
        bot_run "mkdir -p '$SKILLS_DIR/$NAME'"
        TMP=$(mktemp)
        cat > "$TMP" << EOSKILL
---
name: $NAME
description: "TODO: wann soll dieser Skill gezogen werden? Konkrete Stichworte helfen dem Modell."
---

# $NAME

TODO: Beschreibe hier, was der Bot in dieser Situation tun soll.
EOSKILL
        chmod 644 "$TMP"
        bot_run "cp '$TMP' '$SKILLS_DIR/$NAME/SKILL.md'"
        rm -f "$TMP"
        echo -e "${GREEN}✅ Skill-Gerüst angelegt: $SKILLS_DIR/$NAME/SKILL.md${NC}"
        echo -ne "   Jetzt im Editor ausfüllen? [J/n]: "
        read -r DOEDIT
        if [[ ! "$DOEDIT" =~ ^[nN]$ ]]; then
            "$0" edit "$NAME"
        fi
        ;;

    delete|rm)
        if [ -z "$NAME" ]; then
            echo -e "${RED}Usage: ella skills delete <name>${NC}"
            exit 1
        fi
        if ! bot_run "[ -d '$SKILLS_DIR/$NAME' ]"; then
            echo -e "${GREY}Skill '$NAME' existiert nicht — nichts zu löschen.${NC}"
            exit 0
        fi
        echo -n "Skill '$NAME' wirklich löschen? [j/N]: "
        read -r CONFIRM
        if [[ "$CONFIRM" =~ ^[jJ]$ ]]; then
            bot_run "rm -rf '$SKILLS_DIR/$NAME'"
            echo -e "${GREEN}✅ Skill '$NAME' gelöscht.${NC}"
        else
            echo -e "${GREY}Abgebrochen.${NC}"
        fi
        ;;

    # --- ClawHub: OpenClaws eigener Skill-Katalog (vorgefertigte/"vanilla" Skills) ---
    search|find)
        if [ -z "$*" ]; then
            echo -e "${RED}Usage: ella skills search <suchwort>${NC}"
            exit 1
        fi
        echo -e "${BLUE}🔍 ClawHub-Katalog durchsuchen: $*${NC}"
        bot_run "$OPENCLAW_BIN skills search $*"
        echo -e "${GREY}Details:  ella skills info <slug>${NC}"
        echo -e "${GREY}Holen:    ella skills install <slug>${NC}"
        ;;

    info)
        if [ -z "$NAME" ]; then
            echo -e "${RED}Usage: ella skills info <slug>${NC}"
            exit 1
        fi
        bot_run "$OPENCLAW_BIN skills info '$NAME'"
        ;;

    install|add|get)
        if [ -z "$NAME" ]; then
            echo -e "${RED}Usage: ella skills install <slug>${NC}"
            echo -e "${GREY}Erst suchen: ella skills search <suchwort>${NC}"
            exit 1
        fi
        echo -e "${CYAN}📦 Installiere Skill '$NAME' von ClawHub...${NC}"
        bot_run "$OPENCLAW_BIN skills install '$NAME'"
        ;;

    --help|-h)
        echo -e "${BLUE}${BOLD}🧩 ELLA SKILLS — Bot-Skills verwalten${NC}"
        echo -e "${GREY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${BOLD}Eigene Skills im Workspace:${NC}"
        echo -e "  ${GREEN}ella skills list${NC}            Alle Skills mit Status anzeigen"
        echo -e "  ${GREEN}ella skills show <name>${NC}     SKILL.md-Inhalt anzeigen"
        echo -e "  ${GREEN}ella skills edit <name>${NC}     Im Editor bearbeiten (\$EDITOR, sonst nano)"
        echo -e "  ${GREEN}ella skills create <name>${NC}   Neues Skill-Gerüst anlegen (von Hand)"
        echo -e "  ${GREEN}ella skills delete <name>${NC}   Skill löschen (mit Bestätigung)"
        echo -e "${BOLD}ClawHub-Katalog (vorgefertigte Skills):${NC}"
        echo -e "  ${GREEN}ella skills search <wort>${NC}   ClawHub nach Skills durchsuchen"
        echo -e "  ${GREEN}ella skills info <slug>${NC}     Details zu einem ClawHub-Skill"
        echo -e "  ${GREEN}ella skills install <slug>${NC}  Skill von ClawHub in den Workspace holen"
        ;;

    *)
        echo -e "${RED}❌ Unbekannter skills-Befehl: $SUB${NC}"
        echo -e "   ella skills --help"
        exit 1
        ;;
esac
